// ─── chuks_grpc · gRPC over HTTP/2 (h2c) ───────────────────────────────────
// A wire-compatible gRPC server and client built on the HTTP/2 frame layer
// (http2.chuks), HPACK header coding (hpack.chuks), gRPC length-prefixed
// message framing (framing.chuks) and Protocol Buffers (protobuf.chuks).
//
// This implements gRPC over cleartext HTTP/2 ("h2c", a.k.a. prior-knowledge
    // HTTP/2). It interoperates with standard tooling that speaks plaintext gRPC,
// e.g. `grpcurl -plaintext`, Go's `grpc.WithTransportCredentials(insecure...)`,
// and Java's `usePlaintext()`.
//
// Scope:
//   • All four RPC types: unary, server-streaming, client-streaming, bidi.
//   • Full HTTP/2 multiplexing, flow control and CONTINUATION via the actor-
//     model transport (transport.chuks): a per-connection mux + reader task.
//   • TLS and mutual-TLS (mTLS): pass tlsOptions to GrpcServer/GrpcClient to run
//     gRPC over an encrypted HTTP/2 channel. Server handlers can read the peer's
//     certificate Common Name for mTLS identity via GrpcServerStream.peerCommonName()
//     or GrpcRequest.peerCN. Omit tlsOptions to keep cleartext h2c.
//   • No .proto codegen — you serialize/deserialize with ProtoWriter/Reader.
// ───────────────────────────────────────────────────────────────────────────

import { TcpConnection, TcpServer, TlsConnection, TlsServer } from "std/net"
import { Buffer } from "std/buffer"
import { compress } from "std/compress"
import { base64 } from "std/base64"
import { time } from "std/time"
import { HpackHeader } from "./hpack.chuks"
import { GrpcMessage } from "./framing.chuks"
import { ERR_CANCEL } from "./http2.chuks"
import { Http2Conn, Http2Stream, Http2StreamEnd, findHeader, parseDecimal } from "./transport.chuks"
import { ProtoWriter, ProtoReader, ProtoTag, PB_LEN, PB_VARINT } from "./protobuf.chuks"

// ─── gRPC status codes (grpc-status trailer) ───────────────────────────────

export const STATUS_OK: int = 0
export const STATUS_CANCELLED: int = 1
export const STATUS_UNKNOWN: int = 2
export const STATUS_INVALID_ARGUMENT: int = 3
export const STATUS_DEADLINE_EXCEEDED: int = 4
export const STATUS_NOT_FOUND: int = 5
export const STATUS_ALREADY_EXISTS: int = 6
export const STATUS_PERMISSION_DENIED: int = 7
export const STATUS_RESOURCE_EXHAUSTED: int = 8
export const STATUS_FAILED_PRECONDITION: int = 9
export const STATUS_ABORTED: int = 10
export const STATUS_OUT_OF_RANGE: int = 11
export const STATUS_UNIMPLEMENTED: int = 12
export const STATUS_INTERNAL: int = 13
export const STATUS_UNAVAILABLE: int = 14
export const STATUS_DATA_LOSS: int = 15
export const STATUS_UNAUTHENTICATED: int = 16

// Default maximum size (bytes) of a single inbound message accepted on either
// side before it is rejected with RESOURCE_EXHAUSTED. Mirrors the canonical
// gRPC default of 4 MiB. Override per server/client via setMaxRecvMessageBytes;
// pass 0 to disable the limit entirely.
export const DEFAULT_MAX_RECV_MESSAGE_BYTES: int = 4194304

// Sentinel prefix used internally so a too-large inbound message thrown from a
// server-side recv() can be re-mapped to STATUS_RESOURCE_EXHAUSTED by the
// dispatcher (instead of the generic STATUS_INTERNAL).
const _ERR_RECV_TOO_LARGE: string = "grpc: received message larger than max ("

    // Build the human-readable "message too large" string shared by both ends.
    function _recvTooLargeMsg(got: int, limit: int): string {
        return _ERR_RECV_TOO_LARGE + string(got) + " vs. " + string(limit) + ")"
}

// True when an error string came from the too-large-message guardrail.
function _isRecvTooLarge(msg: string): bool {
    return msg.length >= _ERR_RECV_TOO_LARGE.length && msg.startsWith(_ERR_RECV_TOO_LARGE)
}

// ─── Public message types ──────────────────────────────────────────────────

// A decoded unary request handed to a server handler.
export dataType GrpcRequest {
    method: string;        // full path, e.g. "/echo.Echo/Say"
    data: Buffer;          // raw (already de-framed) request message bytes
    metadata: []HpackHeader;
    deadlineMs: int;       // absolute deadline (ms since epoch); 0 if no deadline
    peerCN: string;        // peer certificate Common Name (mTLS); "" if none
}

// A unary response returned by a server handler.
export dataType GrpcResponse {
    data: Buffer;          // raw response message bytes (will be gRPC-framed)
    status: int;           // grpc-status; use STATUS_OK on success
    message: string;       // grpc-message (human-readable, on error)
    details: []ErrorDetail; // structured error details (rich error model); empty on success
}

// A single google.protobuf.Any-encoded error detail: a type URL identifying the
// detail message plus its serialized protobuf bytes. Several of these make up
// the "rich error model" — structured, machine-readable error information that
// travels in the grpc-status-details-bin trailer beside the status code/message.
export dataType ErrorDetail {
    typeUrl: string;       // e.g. "type.googleapis.com/google.rpc.ErrorInfo"
    value: Buffer;         // the serialized detail message bytes
}

// A reply received by the client after a unary call.
export dataType GrpcReply {
    data: Buffer;
    status: int;
    message: string;
    headers: []HpackHeader;    // initial response metadata (server HEADERS)
    trailers: []HpackHeader;   // trailing response metadata (server trailers)
    details: []ErrorDetail;    // decoded rich-error details (empty when none sent)
}

// ─── Retry policy ─────────────────────────────────────────────────────────
// Client-side automatic retry configuration for unary calls. Each attempt is a
// fresh RPC (new stream, interceptors re-run). Between attempts the client waits
// `initialBackoffMs`, then multiplies the backoff by `backoffMultiplier` on each
// subsequent retry, capped at `maxBackoffMs`. Only failures whose grpc-status is
// in `retryableStatuses` are retried, up to `maxAttempts` total attempts.
export dataType RetryPolicy {
    maxAttempts: int;          // total attempts including the first (>= 1)
    initialBackoffMs: int;     // delay before the first retry
    maxBackoffMs: int;         // upper bound on any backoff delay
    backoffMultiplier: int;    // backoff growth factor per retry (e.g. 2)
    retryableStatuses: []int;  // grpc-status codes that trigger a retry
}

// A sensible default policy: up to 3 attempts, 100ms→2s exponential backoff,
// retrying only UNAVAILABLE (transient connectivity) failures.
export function defaultRetryPolicy(): RetryPolicy {
    var codes: []int = [STATUS_UNAVAILABLE]
    var p: RetryPolicy = { maxAttempts: 3, initialBackoffMs: 100, maxBackoffMs: 2000, backoffMultiplier: 2, retryableStatuses: codes }
    return p
}

// True if `status` is one of the policy's retryable codes.
function _isRetryable(policy: RetryPolicy, status: int): bool {
    var codes: []int = policy.retryableStatuses
    var i: int = 0
    while (i < codes.length) {
        if (codes[i] == status) {
            return true
        }
        i = i + 1
    }
    return false
}

// ─── Convenience constructors ──────────────────────────────────────────────

// Build a successful response from raw message bytes.
export function grpcOk(data: Buffer): GrpcResponse {
    var nodet: []ErrorDetail = []
    var r: GrpcResponse = { data: data, status: STATUS_OK, message: "", details: nodet }
    return r
}

// Build an error response with a status code and message (no body).
export function grpcError(status: int, message: string): GrpcResponse {
    var none: []any = []
    var nodet: []ErrorDetail = []
    var r: GrpcResponse = { data: Buffer.fromArray(none), status: status, message: message, details: nodet }
    return r
}

// Build an error response carrying structured rich-error details. The details
// are serialized as a google.rpc.Status message and sent in the
// grpc-status-details-bin trailer; the client reads them back via GrpcReply.details.
export function grpcErrorWithDetails(status: int, message: string, details: []ErrorDetail): GrpcResponse {
    var none: []any = []
    var r: GrpcResponse = { data: Buffer.fromArray(none), status: status, message: message, details: details }
    return r
}

// Build a single rich-error detail from a type URL and its serialized bytes.
export function mkErrorDetail(typeUrl: string, value: Buffer): ErrorDetail {
    var d: ErrorDetail = { typeUrl: typeUrl, value: value }
    return d
}

// ─── Metadata ───────────────────────────────────────────────────────────────
// User-defined key/value pairs carried as HTTP/2 headers (request metadata) and
// trailers (response trailing metadata). gRPC requires ASCII, lowercase keys;
// keys are lowercased here. Reserved HTTP/2 pseudo-headers and gRPC protocol
// headers are never surfaced as user metadata nor allowed to be set.

// Lowercase an ASCII string (gRPC metadata keys must be lowercase).
function asciiLower(s: string): string {
    var b: Buffer = Buffer.fromString(s)
    var n: int = b.length()
    var out: []any = []
    var i: int = 0
    while (i < n) {
        var c: int = b.getByte(i)
        if (c >= 65 && c <= 90) {
            c = c + 32
        }
        out.push(c)
        i = i + 1
    }
    return Buffer.fromArray(out).toStringUtf8()
}

// True for HTTP/2 pseudo-headers and gRPC protocol headers that must not be
// exposed or overwritten as user metadata.
function isReservedHeader(name: string): bool {
    var b: Buffer = Buffer.fromString(name)
    if (b.length() > 0 && b.getByte(0) == 58) {   // leading ':' (pseudo-header)
        return true
    }
    if (name == "content-type") { return true }
    if (name == "te") { return true }
    if (name == "grpc-timeout") { return true }
    if (name == "grpc-status") { return true }
    if (name == "grpc-message") { return true }
    if (name == "grpc-encoding") { return true }
    if (name == "grpc-accept-encoding") { return true }
    if (name == "user-agent") { return true }
    return false
}

export class Metadata {
    var _pairs: []HpackHeader

    constructor() {
        var empty: []HpackHeader = []
        this._pairs = empty
    }

    // Set a key to a single value, replacing any existing values for that key.
    public set(key: string, value: string): void {
        var k: string = asciiLower(key)
        var out: []HpackHeader = []
        var i: int = 0
        while (i < this._pairs.length) {
            if (this._pairs[i].name != k) {
                out.push(this._pairs[i])
            }
            i = i + 1
        }
        out.push(hdr(k, value))
        this._pairs = out
    }

    // Append a value for a key (gRPC metadata keys may repeat).
    public append(key: string, value: string): void {
        this._pairs.push(hdr(asciiLower(key), value))
    }

    // First value for a key, or "" if absent.
    public get(key: string): string {
        return findHeader(this._pairs, asciiLower(key))
    }

    // True if the key is present.
    public has(key: string): bool {
        var k: string = asciiLower(key)
        var i: int = 0
        while (i < this._pairs.length) {
            if (this._pairs[i].name == k) {
                return true
            }
            i = i + 1
        }
        return false
    }

    // All values for a key (in order).
    public getAll(key: string): []string {
        var k: string = asciiLower(key)
        var out: []string = []
        var i: int = 0
        while (i < this._pairs.length) {
            if (this._pairs[i].name == k) {
                out.push(this._pairs[i].value)
            }
            i = i + 1
        }
        return out
    }

    // The number of key/value pairs.
    public size(): int {
        return this._pairs.length
    }

    // The raw header list (for wire encoding). User keys only.
    public pairs(): []HpackHeader {
        return this._pairs
    }
}

// Build Metadata from a raw header list, dropping reserved headers.
export function metadataFromHeaders(h: []HpackHeader): Metadata {
    var md: Metadata = new Metadata()
    var i: int = 0
    while (i < h.length) {
        var name: string = h[i].name
        if (!isReservedHeader(name)) {
            md._pairs.push(hdr(name, h[i].value))
        }
        i = i + 1
    }
    return md
}

// An empty header list literal.
function emptyHeaders(): []HpackHeader {
    var e: []HpackHeader = []
    return e
}

// Construct a client reply with response metadata. If a grpc-status-details-bin
// trailer is present it is base64-decoded and parsed into structured details.
function mkReply(data: Buffer, status: int, message: string, headers: []HpackHeader, trailers: []HpackHeader): GrpcReply {
    var det: []ErrorDetail = []
    var bin: string = findHeader(trailers, "grpc-status-details-bin")
    if (bin.length > 0) {
        det = _decodeStatusDetails(_b64BinDecode(bin))
    }
    var r: GrpcReply = { data: data, status: status, message: message, headers: headers, trailers: trailers, details: det }
    return r
}

// ─── Rich error model (google.rpc.Status / grpc-status-details-bin) ─────────
//
// gRPC carries structured error details in a `grpc-status-details-bin` trailer.
// The value is a serialized google.rpc.Status message, base64-encoded (the
    // `-bin` suffix tells the transport the value is binary). google.rpc.Status is:
//   field 1: code     (int32)
//   field 2: message  (string)
//   field 3: details  (repeated google.protobuf.Any)
// and each google.protobuf.Any is:
//   field 1: type_url (string)
//   field 2: value    (bytes)

// Serialize status code + message + details into a google.rpc.Status message.
function _encodeStatusDetails(code: int, message: string, details: []ErrorDetail): Buffer {
    var w = new ProtoWriter()
    w.writeInt32(1, code)
    w.writeString(2, message)
    var i: int = 0
    while (i < details.length) {
        var anyw = new ProtoWriter()
        anyw.writeString(1, details[i].typeUrl)
        anyw.writeBytes(2, details[i].value)
        w.writeMessage(3, anyw)
        i = i + 1
    }
    return w.toBuffer()
}

// Parse a serialized google.rpc.Status message into its detail list.
function _decodeStatusDetails(data: Buffer): []ErrorDetail {
    var out: []ErrorDetail = []
    var r = new ProtoReader(data)
    while (r.hasMore()) {
        var tag: ProtoTag = r.readTag()
        if (tag.field == 3 && tag.wireType == PB_LEN) {
            var any: ProtoReader = r.readMessage()
            var typeUrl: string = ""
            var value: Buffer = emptyBuf()
            while (any.hasMore()) {
                var at: ProtoTag = any.readTag()
                if (at.field == 1 && at.wireType == PB_LEN) {
                    typeUrl = any.readString()
                } else if (at.field == 2 && at.wireType == PB_LEN) {
                    value = any.readBytes()
                } else {
                    any.skip(at.wireType)
                }
            }
            var d: ErrorDetail = { typeUrl: typeUrl, value: value }
            out.push(d)
        } else {
            r.skip(tag.wireType)
        }
    }
    return out
}

// Encode a status (code/message/details) as the base64 trailer value. The
// padding ('=') is stripped to match gRPC's RawStdEncoding for binary metadata,
// keeping the trailer interoperable with real gRPC servers/clients (grpcurl, Go).
function _encodeStatusDetailsBin(code: int, message: string, details: []ErrorDetail): string {
    var raw: Buffer = _encodeStatusDetails(code, message, details)
    return _stripB64Pad(base64.encodeBuffer(raw))
}

// Decode a base64 (RawStdEncoding, no padding) trailer value into a Buffer.
function _b64BinDecode(s: string): Buffer {
    return base64.decodeToBuffer(_padB64(s))
}

// Remove trailing '=' padding from a base64 string.
function _stripB64Pad(s: string): string {
    var b: Buffer = Buffer.fromString(s)
    var end: int = b.length()
    while (end > 0 && b.getByte(end - 1) == 61) {
        end = end - 1
    }
    var out: []any = []
    var i: int = 0
    while (i < end) {
        out.push(b.getByte(i))
        i = i + 1
    }
    return Buffer.fromArray(out).toStringUtf8()
}

// Re-add '=' padding so a RawStdEncoding base64 string can be standard-decoded.
function _padB64(s: string): string {
    var rem: int = s.length % 4
    var out: string = s
    if (rem == 2) {
        out = out + "=="
    } else if (rem == 3) {
        out = out + "="
    }
    return out
}

// ─── Internal helpers ──────────────────────────────────────────────────────

function emptyBuf(): Buffer {
    var none: []any = []
    return Buffer.fromArray(none)
}

// Build a single header.
function hdr(name: string, value: string): HpackHeader {
    var h: HpackHeader = { name: name, value: value }
    return h
}

// ─── Deadlines (grpc-timeout) ──────────────────────────────────────────────
// gRPC carries a per-call timeout in the "grpc-timeout" header as
// <digits><unit>, unit ∈ {H,M,S,m,u,n}. We encode in whichever unit keeps the
// value within the 8-digit wire limit, and decode back to milliseconds.

function encodeTimeout(ms: int): string {
    var v: int = ms
    if (v < 0) {
        v = 0
    }
    if (v <= 99999999) {
        return string(v) + "m"
    }
    var secs: int = v / 1000
    if (secs <= 99999999) {
        return string(secs) + "S"
    }
    var mins: int = secs / 60
    if (mins <= 99999999) {
        return string(mins) + "M"
    }
    var hours: int = mins / 60
    return string(hours) + "H"
}

// Parse a "grpc-timeout" value to milliseconds (0 if absent/invalid).
function parseTimeout(s: string): int {
    var b: Buffer = Buffer.fromString(s)
    var n: int = b.length()
    if (n < 2) {
        return 0
    }
    var unit: int = b.getByte(n - 1)
    var val: int = parseDecimal(s)   // parseDecimal ignores the trailing unit letter
    if (unit == 72) {                // 'H'
        return val * 3600000
    }
    if (unit == 77) {                // 'M'
        return val * 60000
    }
    if (unit == 83) {                // 'S'
        return val * 1000
    }
    if (unit == 109) {               // 'm' (milliseconds)
        return val
    }
    if (unit == 117) {               // 'u' (microseconds)
        return val / 1000
    }
    if (unit == 110) {               // 'n' (nanoseconds)
        return val / 1000000
    }
    return 0
}

// Resolve an absolute deadline (ms since epoch) from request metadata, or 0.
function deadlineFromMeta(meta: []HpackHeader): int {
    var tv: string = findHeader(meta, "grpc-timeout")
    if (tv.length == 0) {
        return 0
    }
    var ms: int = parseTimeout(tv)
    if (ms <= 0) {
        return 0
    }
    return time.now() + ms
}

// Standard gRPC request headers for a client call to `method`.
function requestHeaders(method: string, authority: string): []HpackHeader {
    return requestHeadersT(method, authority, 0)
}

// Request headers with an optional per-call timeout (ms). 0 = no deadline.
function requestHeadersT(method: string, authority: string, timeoutMs: int): []HpackHeader {
    var hs: []HpackHeader = [
        hdr(":method", "POST"),
        hdr(":scheme", "http"),
        hdr(":path", method),
        hdr(":authority", authority),
        hdr("content-type", "application/grpc"),
        hdr("te", "trailers"),
    ]
    if (timeoutMs > 0) {
        hs.push(hdr("grpc-timeout", encodeTimeout(timeoutMs)))
    }
    return hs
}

// Request headers with a per-call timeout and custom user metadata appended.
// Reserved headers in `md` are skipped so the protocol headers can't be spoofed.
function requestHeadersM(method: string, authority: string, timeoutMs: int, md: Metadata): []HpackHeader {
    var hs: []HpackHeader = requestHeadersT(method, authority, timeoutMs)
    var extra: []HpackHeader = md.pairs()
    var i: int = 0
    while (i < extra.length) {
        if (!isReservedHeader(extra[i].name)) {
            hs.push(extra[i])
        }
        i = i + 1
    }
    return hs
}

// Standard gRPC response headers (initial server HEADERS).
function responseHeaders(): []HpackHeader {
    var hs: []HpackHeader = [hdr(":status", "200"), hdr("content-type", "application/grpc")]
    return hs
}

// ─── Message compression (grpc-encoding negotiation) ───────────────────────
// gRPC negotiates per-message compression via two headers:
//   • grpc-encoding         — the codec used for outbound messages ("gzip" or
    //                             "identity"); also set on responses by the server.
//   • grpc-accept-encoding  — a comma list of codecs the sender can decode.
// Each length-prefixed frame carries a 1-byte "compressed" flag, so the receiver
// decodes purely from that flag (we only ship the gzip codec, so a set flag
    // always means gzip). Tiny payloads can grow once framed/compressed; that is
// expected and harmless.

export const ENCODING_IDENTITY: string = "identity"
export const ENCODING_GZIP: string = "gzip"

// The codecs this implementation advertises it can decode, most-preferred first.
function acceptEncodingHeader(): string {
    return "gzip,identity"
}

// True if `headerValue` (a grpc-accept-encoding list) advertises gzip support.
function acceptsGzip(headerValue: string): bool {
    return headerValue.indexOf("gzip") >= 0
}

// Normalise a user-supplied codec name to one we support ("gzip" | "identity").
function normalizeEncoding(encoding: string): string {
    if (encoding == ENCODING_GZIP) {
        return ENCODING_GZIP
    }
    return ENCODING_IDENTITY
}

// Send `data` on `st`, compressing with the negotiated `encoding` when gzip.
function sendEncoded(st: Http2Stream, data: Buffer, encoding: string): void {
    if (encoding == ENCODING_GZIP) {
        st.sendMessageEncoded(compress.gzip(data), true)
    } else {
        st.sendMessage(data)
    }
}

// Decode an inbound message: decompress when its compressed flag is set (the
    // only codec we negotiate is gzip), otherwise return the raw bytes.
function decodeMessage(m: GrpcMessage): Buffer {
    if (m.compressed) {
        return compress.gunzip(m.data)
    }
    return m.data
}

// ─── RPC kinds ─────────────────────────────────────────────────────────────

export const RPC_UNARY: int = 0
export const RPC_SERVER_STREAM: int = 1
export const RPC_CLIENT_STREAM: int = 2
export const RPC_BIDI: int = 3

// ─── Server-side stream handle ─────────────────────────────────────────────
// The context object passed to streaming server handlers. Wraps a transport
// Http2Stream and lazily emits the response HEADERS on the first send so a
// handler can fail before producing any output (trailers-only error).

export class GrpcServerStream {
    var _st: Http2Stream
    var _method: string
    var _meta: []HpackHeader
    var _headersSent: bool
    var _deadlineMs: int
    var _cancelObserved: bool
    var _respHeaders: []HpackHeader
    var _respTrailers: []HpackHeader
    var _respEncoding: string
    var _peerCN: string
    var _finishStatus: int   // terminal grpc-status sent by finish(); STATUS_OK until then
    var _statusDetailsBin: string  // base64 grpc-status-details-bin trailer value ("" = none)
    var _maxRecvBytes: int   // reject inbound messages larger than this (0 = unlimited)

    constructor(st: Http2Stream, method: string, meta: []HpackHeader, serverCompress: bool, peerCN: string, maxRecvBytes: int) {
        this._st = st
        this._method = method
        this._meta = meta
        this._peerCN = peerCN
        this._finishStatus = STATUS_OK
        this._statusDetailsBin = ""
        this._maxRecvBytes = maxRecvBytes
        this._headersSent = false
        this._deadlineMs = deadlineFromMeta(meta)
        this._cancelObserved = false
        var hh: []HpackHeader = []
        this._respHeaders = hh
        var tt: []HpackHeader = []
        this._respTrailers = tt
        // Compress responses only when the server opted in AND the client
        // advertised it can decode gzip (grpc-accept-encoding).
        this._respEncoding = ENCODING_IDENTITY
        if (serverCompress) {
            var accept: string = findHeader(meta, "grpc-accept-encoding")
            if (acceptsGzip(accept)) {
                this._respEncoding = ENCODING_GZIP
            }
        }
    }

    // The full method path, e.g. "/package.Service/Method".
    public method(): string {
        return this._method
    }

    // The request's initial metadata (HTTP/2 request headers).
    public metadata(): []HpackHeader {
        return this._meta
    }

    // The request's user metadata (reserved/protocol headers removed).
    public requestMetadata(): Metadata {
        return metadataFromHeaders(this._meta)
    }

    // The peer certificate's Common Name when the connection is mutually
    // authenticated (mTLS), or "" for plaintext / server-only TLS connections.
    public peerCommonName(): string {
        return this._peerCN
    }

    // The codec used for the client's request messages ("gzip" | "identity").
    public requestEncoding(): string {
        var enc: string = findHeader(this._meta, "grpc-encoding")
        return normalizeEncoding(enc)
    }

    // The codec used for this stream's response messages ("gzip" | "identity").
    public responseEncoding(): string {
        return this._respEncoding
    }

    // First value of a request header by (case-insensitive) key, or "".
    public header(key: string): string {
        return findHeader(this._meta, asciiLower(key))
    }

    // Add a custom response header (initial metadata). Must be called before the
    // first send()/finish(); later calls are ignored once headers are flushed.
    public setHeader(key: string, value: string): void {
        if (this._headersSent) {
            return
        }
        if (isReservedHeader(asciiLower(key))) {
            return
        }
        this._respHeaders.push(hdr(asciiLower(key), value))
    }

    // Add a custom trailing-metadata header, sent with the terminal status.
    public setTrailer(key: string, value: string): void {
        if (isReservedHeader(asciiLower(key))) {
            return
        }
        this._respTrailers.push(hdr(asciiLower(key), value))
    }

    // Absolute deadline for this RPC (ms since epoch), or 0 if the client set
    // none. Compare against time.now() to budget work cooperatively.
    public deadlineMs(): int {
        return this._deadlineMs
    }

    // True once the client's deadline (if any) has elapsed.
    public deadlineExceeded(): bool {
        if (this._deadlineMs == 0) {
            return false
        }
        return time.now() >= this._deadlineMs
    }

    // True once the client has cancelled the RPC (RST_STREAM) or the deadline
    // has elapsed. Long-running streaming handlers should poll this and return
    // promptly so work isn't wasted on an abandoned call. The cancellation is
    // observed via the stream's one-shot terminal signal (delivered by the
        // transport reader on reset) and memoised here.
    public cancelled(): bool {
        if (this._cancelObserved) {
            return true
        }
        if (this.deadlineExceeded()) {
            return true
        }
        var end: Http2StreamEnd? = this._st.tryResult()
        if (end != null) {
            this._cancelObserved = true
            return true
        }
        return false
    }

    // Receive the next request message, or null once the client half-closes.
    // Enforces the configured max inbound message size: an oversized message is
    // rejected by throwing, which the dispatcher maps to RESOURCE_EXHAUSTED.
    public recv(): Buffer? {
        var m: GrpcMessage? = this._st.recv()
        if (m != null) {
            var data: Buffer = decodeMessage(m)
            if (this._maxRecvBytes > 0 && data.length() > this._maxRecvBytes) {
                throw _recvTooLargeMsg(data.length(), this._maxRecvBytes)
            }
            return data
        }
        return null
    }

    // Emit the response HEADERS exactly once (before the first message).
    private _ensureHeaders(): void {
        if (!this._headersSent) {
            this._headersSent = true
            var hs: []HpackHeader = responseHeaders()
            if (this._respEncoding == ENCODING_GZIP) {
                hs.push(hdr("grpc-encoding", "gzip"))
            }
            var i: int = 0
            while (i < this._respHeaders.length) {
                hs.push(this._respHeaders[i])
                i = i + 1
            }
            this._st.sendHeaders(hs, false)
        }
    }

    // Send one response message on the stream.
    public send(data: Buffer): void {
        this._ensureHeaders()
        sendEncoded(this._st, data, this._respEncoding)
    }

    // The terminal grpc-status this stream finished with (STATUS_OK until
        // finish() is called). Used by the server stats hooks (M17) to report the
    // outcome of streaming RPCs.
    public finishStatus(): int {
        return this._finishStatus
    }

    // Attach structured rich-error details to be sent alongside the terminal
    // status. The details are serialized as a google.rpc.Status message and
    // emitted (base64-encoded) in the grpc-status-details-bin trailer when
    // finish() is called. Call this before finish(); a later status/message is
    // taken from finish() itself. Passing an empty list clears any details.
    public setStatusDetails(status: int, message: string, details: []ErrorDetail): void {
        if (details.length == 0) {
            this._statusDetailsBin = ""
            return
        }
        this._statusDetailsBin = _encodeStatusDetailsBin(status, message, details)
    }

    // Finish the RPC with a status and message (sends trailers, ends stream).
    public finish(status: int, message: string): void {
        this._finishStatus = status
        this._ensureHeaders()
        var trailers: []HpackHeader = [hdr("grpc-status", string(status)), hdr("grpc-message", message)]
        if (this._statusDetailsBin.length > 0) {
            trailers.push(hdr("grpc-status-details-bin", this._statusDetailsBin))
        }
        var i: int = 0
        while (i < this._respTrailers.length) {
            trailers.push(this._respTrailers[i])
            i = i + 1
        }
        this._st.sendTrailers(trailers)
    }
}

// A completed-RPC observation handed to every registered stats handler (M17)
// once a call finishes. Stats handlers are passive observers — they receive a
// snapshot and must not mutate the RPC. The same shape is used on both the
// server (isClient = false) and client (isClient = true) so a single handler
// type works on either side, making it easy to feed metrics counters or build
// a tracing span from start/end timestamps.
export dataType RpcStats {
    method: string      // full method path, e.g. "/pkg.Service/Method"
    isClient: bool      // true for client-side stats, false for server-side
    status: int         // terminal grpc-status code (STATUS_OK == success)
    startMs: int        // RPC start time (ms since epoch)
    endMs: int          // RPC end time (ms since epoch)
    durationMs: int     // endMs - startMs convenience field
    peerCN: string      // mTLS peer Common Name on the server side, else ""
}

// ─── Server ────────────────────────────────────────────────────────────────

export class GrpcServer {
    var _server: TcpServer
    var _handlers: map[string]any
    var _kinds: map[string]int
    var _compress: bool
    var _unaryInterceptors: []any   // function(req: GrpcRequest, next: any): GrpcResponse
    var _streamInterceptors: []any  // function(stream: GrpcServerStream, next: any): void
    var _statsHandlers: []any       // function(stats: RpcStats): void — fired per finished RPC
    var _kaTime: int                // keepalive ping interval (ms; 0 = disabled)
    var _kaTimeout: int             // keepalive ack timeout (ms)
    var _maxRecvBytes: int          // max inbound message size (bytes; 0 = unlimited)

    // Bind a listener immediately. Pass port 0 for an OS-assigned port and read
    // it back via addr(). Provide tlsOptions to serve over TLS/mTLS instead of
    // cleartext h2c: {cert, key} for server TLS, plus {clientCA, requireClientCert}
    // to require and verify client certificates (mutual TLS).
    constructor(host: string, port: int, tlsOptions: any?) {
        if (tlsOptions != null) {
            this._server = new TlsServer(host, port, tlsOptions)
        } else {
            this._server = new TcpServer(host, port)
        }
        this._handlers = {}
        this._kinds = {}
        this._compress = false
        this._unaryInterceptors = []
        this._streamInterceptors = []
        this._statsHandlers = []
        this._kaTime = 0
        this._kaTimeout = 0
        this._maxRecvBytes = DEFAULT_MAX_RECV_MESSAGE_BYTES
    }

    // Opt in to response compression. When enabled, responses are gzip-compressed
    // for clients that advertise gzip support via grpc-accept-encoding; other
    // clients still receive identity (uncompressed) messages.
    public enableCompression(): void {
        this._compress = true
    }

    // Enable HTTP/2 keepalive for every accepted connection: each connection
    // pings idle peers every `timeMs` and is dropped if no ACK returns within
    // `timeoutMs`, reclaiming resources from half-open clients. Set before serve().
    public enableKeepalive(timeMs: int, timeoutMs: int): void {
        this._kaTime = timeMs
        this._kaTimeout = timeoutMs
    }

    // Cap the size (bytes) of any single inbound request message. A larger
    // message is rejected with STATUS_RESOURCE_EXHAUSTED before the handler runs
    // (or, for streaming RPCs, when recv() reads it), protecting the server from
    // unbounded memory use. Defaults to DEFAULT_MAX_RECV_MESSAGE_BYTES (4 MiB);
    // pass 0 to disable the limit. Set before serve().
    public setMaxRecvMessageBytes(maxBytes: int): void {
        this._maxRecvBytes = maxBytes
    }

    // Register a unary server interceptor. Interceptors run in registration
    // order (outermost first) around every unary handler:
    //   function(req: GrpcRequest, next: any): GrpcResponse
    // Call `next(req)` to proceed to the next interceptor (and finally the
        // handler); return a GrpcResponse without calling `next` to short-circuit.
    public useUnaryInterceptor(interceptor: any): void {
        this._unaryInterceptors.push(interceptor)
    }

    // Register a streaming server interceptor. Wraps every server-streaming,
    // client-streaming and bidi handler in registration order:
    //   function(stream: GrpcServerStream, next: any): void
    // Call `next(stream)` to proceed. An interceptor that short-circuits (does
        // not call `next`) is responsible for finishing the stream itself.
    public useStreamInterceptor(interceptor: any): void {
        this._streamInterceptors.push(interceptor)
    }

    // Register a stats/tracing observer invoked once for every RPC this server
    // handles, after the call finishes (including methods that are not found):
    //   function(stats: RpcStats): void
    // Handlers run in registration order and receive a read-only RpcStats
    // snapshot (method, status, start/end/duration, peer CN). Use them to feed
    // metrics counters/histograms or to record a completed tracing span. A
    // throwing handler must not interfere with the RPC, so keep them cheap and
    // non-blocking.
    public useStatsHandler(handler: any): void {
        this._statsHandlers.push(handler)
    }

    // Register a unary handler:
    //   function(req: GrpcRequest): GrpcResponse
    public register(method: string, handler: any): void {
        this._handlers[method] = handler
        this._kinds[method] = RPC_UNARY
    }

    // Register a server-streaming handler (one request, many responses):
    //   function(req: GrpcRequest, stream: GrpcServerStream): void
    public registerServerStream(method: string, handler: any): void {
        this._handlers[method] = handler
        this._kinds[method] = RPC_SERVER_STREAM
    }

    // Register a client-streaming handler (many requests, one response):
    //   function(stream: GrpcServerStream): GrpcResponse
    public registerClientStream(method: string, handler: any): void {
        this._handlers[method] = handler
        this._kinds[method] = RPC_CLIENT_STREAM
    }

    // Register a bidirectional-streaming handler (many requests, many responses):
    //   function(stream: GrpcServerStream): void
    public registerBidiStream(method: string, handler: any): void {
        this._handlers[method] = handler
        this._kinds[method] = RPC_BIDI
    }

    // The address the server is listening on ("host:port").
    public addr(): string {
        return this._server.addr()
    }

    // The distinct fully-qualified service names derived from every registered
    // method path ("/pkg.Service/Method" → "pkg.Service"). Used by the server
    // reflection service (M16) to advertise what this server hosts.
    public serviceNames(): []string {
        var seen: map[string]bool = {}
        var out: []string = []
        for (var path in this._handlers) {
            var name: string = _serviceNameFromPath(path)
            if (name.length > 0 && !seen.has(name)) {
                seen[name] = true
                out.push(name)
            }
        }
        return out
    }

    // Accept connections forever, serving each on its own task so multiple
    // connections (and all their multiplexed streams) run concurrently.
    public serve(): void {
        while (true) {
            var conn: TcpConnection = this._server.accept()
            spawn _serveConn(this, conn)
        }
    }

    // Accept exactly one connection and serve it until the peer disconnects.
    // Useful for tests and request/response tooling.
    public serveOnce(): void {
        var conn: TcpConnection = this._server.accept()
        _serveConnSync(this, conn)
    }

    public close(): void {
        this._server.close()
    }
}

// Serve every stream on one connection until it closes (blocking).
function _serveConnSync(srv: GrpcServer, conn: TcpConnection): void {
    var h2: Http2Conn = new Http2Conn(conn, true)
    h2.serverHandshake()
    // Read the peer's certificate identity only after the HTTP/2 preface has
    // forced the TLS handshake to complete; "" for plaintext / server-only TLS.
    var peerCN: string = conn.peerCommonName()
    h2.start()
    if (srv._kaTime > 0) {
        h2.enableKeepalive(srv._kaTime, srv._kaTimeout)
    }
    var st: Http2Stream? = h2.acceptStream()
    while (st != null) {
        spawn _serveStream(srv, st, peerCN)
        st = h2.acceptStream()
    }
}

// Async wrapper so serve() can fan out a connection onto its own task.
async function _serveConn(srv: GrpcServer, conn: TcpConnection): Task<void> {
    _serveConnSync(srv, conn)
}

// Dispatch a single accepted stream to its registered handler.
async function _serveStream(srv: GrpcServer, st: Http2Stream, peerCN: string): Task<void> {
    var path: string = findHeader(st.initialMeta, ":path")
    var ss: GrpcServerStream = new GrpcServerStream(st, path, st.initialMeta, srv._compress, peerCN, srv._maxRecvBytes)

    if (!srv._handlers.has(path)) {
        ss.finish(STATUS_UNIMPLEMENTED, "method not found: " + path)
        _emitServerStats(srv, path, peerCN, time.now(), STATUS_UNIMPLEMENTED)
        return
    }

    var kind: int = srv._kinds[path]
    var handler: any = srv._handlers[path]

    var _statStart: int = time.now()
    var _statStatus: int = STATUS_OK

    try {
        if (kind == RPC_UNARY) {
            var reqData: Buffer = emptyBuf()
            var m: Buffer? = ss.recv()
            if (m != null) {
                reqData = m
            }
            var req: GrpcRequest = { method: path, data: reqData, metadata: st.initialMeta, deadlineMs: ss.deadlineMs(), peerCN: peerCN }
            var unaryTerminal = function(rq: GrpcRequest): GrpcResponse {
                return handler(rq)
            }
            var resp: GrpcResponse = _runServerUnary(srv._unaryInterceptors, 0, req, unaryTerminal)
            if (resp.status != STATUS_OK) {
                ss.setStatusDetails(resp.status, resp.message, resp.details)
                ss.finish(resp.status, resp.message)
            } else {
                ss.send(resp.data)
                ss.finish(STATUS_OK, "")
            }
            _statStatus = resp.status
        } else if (kind == RPC_SERVER_STREAM) {
            var reqData2: Buffer = emptyBuf()
            var m2: Buffer? = ss.recv()
            if (m2 != null) {
                reqData2 = m2
            }
            var req2: GrpcRequest = { method: path, data: reqData2, metadata: st.initialMeta, deadlineMs: ss.deadlineMs(), peerCN: peerCN }
            var ssTerminal = function(s: GrpcServerStream): void {
                handler(req2, s)
                s.finish(STATUS_OK, "")
            }
            _runServerStream(srv._streamInterceptors, 0, ss, ssTerminal)
            _statStatus = ss.finishStatus()
        } else if (kind == RPC_CLIENT_STREAM) {
            var csTerminal = function(s: GrpcServerStream): void {
                var resp3: GrpcResponse = handler(s)
                if (resp3.status != STATUS_OK) {
                    s.finish(resp3.status, resp3.message)
                } else {
                    s.send(resp3.data)
                    s.finish(STATUS_OK, "")
                }
            }
            _runServerStream(srv._streamInterceptors, 0, ss, csTerminal)
            _statStatus = ss.finishStatus()
        } else {
            var bidiTerminal = function(s: GrpcServerStream): void {
                handler(s)
                s.finish(STATUS_OK, "")
            }
            _runServerStream(srv._streamInterceptors, 0, ss, bidiTerminal)
            _statStatus = ss.finishStatus()
        }
    } catch (e) {
        var em: string = string(e)
        if (_isRecvTooLarge(em)) {
            ss.finish(STATUS_RESOURCE_EXHAUSTED, em)
            _statStatus = STATUS_RESOURCE_EXHAUSTED
        } else {
            ss.finish(STATUS_INTERNAL, em)
            _statStatus = STATUS_INTERNAL
        }
    }

    _emitServerStats(srv, path, peerCN, _statStart, _statStatus)
}

// Build an RpcStats snapshot for a finished server RPC and hand it to every
// registered stats handler in order. A no-op when no handlers are registered.
function _emitServerStats(srv: GrpcServer, method: string, peerCN: string, startMs: int, status: int): void {
    if (srv._statsHandlers.length == 0) {
        return
    }
    var endMs: int = time.now()
    var stats: RpcStats = {
        method: method,
        isClient: false,
        status: status,
        startMs: startMs,
        endMs: endMs,
        durationMs: endMs - startMs,
        peerCN: peerCN,
    }
    var i: int = 0
    while (i < srv._statsHandlers.length) {
        var h: any = srv._statsHandlers[i]
        h(stats)
        i = i + 1
    }
}

// ─── Interceptor chains ─────────────────────────────────────────────────────
// These are module-level recursive helpers (not class methods) so the captured
// `next` closures never reach into private class state — keeping them valid
// under the access rules the typechecker enforces in both VM and AOT.

// Drive the server unary interceptor chain. `interceptors[idx]` has signature
// function(req: GrpcRequest, next: any): GrpcResponse; `terminal` is the actual
// handler call function(req: GrpcRequest): GrpcResponse.
function _runServerUnary(interceptors: []any, idx: int, req: GrpcRequest, terminal: any): GrpcResponse {
    if (idx >= interceptors.length) {
        return terminal(req)
    }
    var interceptor: any = interceptors[idx]
    var next = function(r: GrpcRequest): GrpcResponse {
        return _runServerUnary(interceptors, idx + 1, r, terminal)
    }
    return interceptor(req, next)
}

// Drive the server streaming interceptor chain. `interceptors[idx]` has
// signature function(stream: GrpcServerStream, next: any): void; `terminal`
// performs the handler call and finishes the stream.
function _runServerStream(interceptors: []any, idx: int, ss: GrpcServerStream, terminal: any): void {
    if (idx >= interceptors.length) {
        terminal(ss)
        return
    }
    var interceptor: any = interceptors[idx]
    var next = function(s: GrpcServerStream): void {
        _runServerStream(interceptors, idx + 1, s, terminal)
    }
    interceptor(ss, next)
}

// Drive the client unary interceptor chain. `interceptors[idx]` has signature
// function(method: string, message: Buffer, md: Metadata, next: any): GrpcReply;
// `terminal` issues the real RPC: function(method, message, md): GrpcReply.
function _runClientUnary(interceptors: []any, idx: int, method: string, message: Buffer, md: Metadata, terminal: any): GrpcReply {
    if (idx >= interceptors.length) {
        return terminal(method, message, md)
    }
    var interceptor: any = interceptors[idx]
    var next = function(m: string, msg: Buffer, d: Metadata): GrpcReply {
        return _runClientUnary(interceptors, idx + 1, m, msg, d, terminal)
    }
    return interceptor(method, message, md, next)
}

// ─── Client-side stream handle ─────────────────────────────────────────────
// Returned by the streaming client openers. Wraps a transport Http2Stream.

export class GrpcClientCall {
    var _st: Http2Stream
    var _deadlineMs: int   // absolute deadline (ms since epoch); 0 = none
    var _cancelled: bool   // set by cancel()
    var _trailers: []HpackHeader   // captured at result()
    var _encoding: string  // outbound message codec ("gzip" | "identity")

    constructor(st: Http2Stream, encoding: string) {
        this._st = st
        this._deadlineMs = 0
        this._cancelled = false
        var tt: []HpackHeader = []
        this._trailers = tt
        this._encoding = encoding
    }

    // Attach an absolute deadline (ms since epoch). Called by the client openers
    // when a per-call timeout was requested.
    public _setDeadline(absMs: int): void {
        this._deadlineMs = absMs
    }

    // Cancel the RPC: send RST_STREAM(CANCEL) to the server so it can stop work
    // (the server handler observes this via GrpcServerStream.cancelled()). A
    // subsequent result() on this call returns STATUS_CANCELLED immediately.
    // Call cancel() from the same task that drives the call.
    public cancel(): void {
        if (this._cancelled) {
            return
        }
        this._cancelled = true
        this._st.reset(ERR_CANCEL)
    }

    // True once cancel() has been called on this call.
    public isCancelled(): bool {
        return this._cancelled
    }

    // Send one request message on the stream.
    public send(data: Buffer): void {
        sendEncoded(this._st, data, this._encoding)
    }

    // Close the send side (half-close): no more request messages.
    public closeSend(): void {
        this._st.closeSend()
    }

    // Receive the next response message, or null once the server half-closes.
    public recv(): Buffer? {
        var m: GrpcMessage? = this._st.recv()
        if (m != null) {
            return decodeMessage(m)
        }
        return null
    }

    // The initial response metadata (server HEADERS). Available once the first
    // message has been received or the call has finished.
    public headers(): Metadata {
        return metadataFromHeaders(this._st.initialMeta)
    }

    // The trailing response metadata. Populated after result() returns.
    public trailers(): Metadata {
        return metadataFromHeaders(this._trailers)
    }

    // Block for the terminal status/trailers of the call. When a deadline was
    // set, polls so the call cannot hang past it: on expiry the stream is reset
    // and a DEADLINE_EXCEEDED reply is returned.
    public result(): GrpcReply {
        if (this._cancelled) {
            return mkReply(emptyBuf(), STATUS_CANCELLED, "call cancelled", emptyHeaders(), emptyHeaders())
        }
        if (this._deadlineMs == 0) {
            var end: Http2StreamEnd = this._st.result()
            this._trailers = end.trailers
            return mkReply(emptyBuf(), end.status, end.message, this._st.initialMeta, end.trailers)
        }
        while (true) {
            var done: Http2StreamEnd? = this._st.tryResult()
            if (done != null) {
                this._trailers = done.trailers
                return mkReply(emptyBuf(), done.status, done.message, this._st.initialMeta, done.trailers)
            }
            if (time.now() >= this._deadlineMs) {
                this._st.reset(ERR_CANCEL)
                return mkReply(emptyBuf(), STATUS_DEADLINE_EXCEEDED, "deadline exceeded", emptyHeaders(), emptyHeaders())
            }
            time.sleep(1)
        }
    }
}

// ─── Client ────────────────────────────────────────────────────────────────

export class GrpcClient {
    var _conn: TcpConnection
    var _h2: Http2Conn
    var _authority: string
    var _encoding: string   // outbound request message codec ("gzip" | "identity")
    var _unaryInterceptors: []any   // function(method: string, message: Buffer, md: Metadata, next: any): GrpcReply
    var _statsHandlers: []any       // function(stats: RpcStats): void — fired per finished unary call
    var _retryEnabled: bool         // automatic unary retries on/off
    var _retry: RetryPolicy         // active retry policy (default when disabled)
    var _maxRecvBytes: int          // max inbound message size (bytes; 0 = unlimited)

    // Connect over HTTP/2, exchange the preface, and start the multiplexing
    // reader/mux tasks. Without tlsOptions this is cleartext h2c; pass tlsOptions
    // to connect over TLS/mTLS: {ca} or {skipVerify} to trust the server, plus
    // {cert, key} to present a client certificate (mutual TLS).
    constructor(host: string, port: int, tlsOptions: any?) {
        if (tlsOptions != null) {
            this._conn = new TlsConnection(host, port, tlsOptions)
        } else {
            this._conn = new TcpConnection(host, port)
        }
        this._authority = host + ":" + string(port)
        this._h2 = new Http2Conn(this._conn, false)
        this._h2.clientHandshake()
        this._h2.start()
        this._encoding = ENCODING_IDENTITY
        this._unaryInterceptors = []
        this._statsHandlers = []
        this._retryEnabled = false
        this._retry = defaultRetryPolicy()
        this._maxRecvBytes = DEFAULT_MAX_RECV_MESSAGE_BYTES
    }

    public close(): void {
        this._h2.close()
        this._conn.close()
    }

    // Enable HTTP/2 keepalive: ping the server every `timeMs` and tear the
    // connection down if no PING ACK arrives within `timeoutMs` (in-flight calls
        // then fail with UNAVAILABLE). Detects half-open / dead connections so calls
    // fail fast instead of hanging. Call once after constructing the client.
    public enableKeepalive(timeMs: int, timeoutMs: int): void {
        this._h2.enableKeepalive(timeMs, timeoutMs)
    }

    // Diagnostics: number of keepalive PING ACKs received from the server so far.
    public keepaliveAcks(): int {
        return this._h2.pingAcks()
    }

    // Opt in to request compression. When set to "gzip", outbound request messages
    // are gzip-compressed and the call advertises `grpc-encoding: gzip`. Any value
    // other than "gzip" resets to identity (uncompressed). Clients always advertise
    // `grpc-accept-encoding: gzip,identity`, so a compressed response is decoded
    // regardless of the request codec.
    public setCompression(encoding: string): void {
        this._encoding = normalizeEncoding(encoding)
    }

    // Register a unary client interceptor. Interceptors run in registration
    // order (outermost first) around every unary call:
    //   function(method: string, message: Buffer, md: Metadata, next: any): GrpcReply
    // Call `next(method, message, md)` to issue the RPC (possibly with modified
        // arguments); inspect or replace the returned GrpcReply, or short-circuit by
    // returning a GrpcReply without calling `next`.
    public useUnaryInterceptor(interceptor: any): void {
        this._unaryInterceptors.push(interceptor)
    }

    // Register a stats/tracing observer invoked once per unary call, after it
    // finishes (a retried call reports its final outcome as a single event):
    //   function(stats: RpcStats): void
    // Handlers run in registration order with a read-only RpcStats snapshot
    // (isClient = true; peerCN is "" on the client). Use them for client-side
    // latency/error metrics or to record an outgoing tracing span.
    public useStatsHandler(handler: any): void {
        this._statsHandlers.push(handler)
    }

    // Enable automatic retries for unary calls using `policy`. Each retry is a
    // fresh attempt (new stream; interceptors re-run) issued after an exponential
    // backoff, but only when the failure status is retryable. Retries apply to
    // unary RPCs only — streaming calls are never retried automatically. Pass
    // defaultRetryPolicy() for sensible defaults.
    public setRetryPolicy(policy: RetryPolicy): void {
        this._retry = policy
        this._retryEnabled = true
    }

    // Disable automatic retries (the default).
    public disableRetries(): void {
        this._retryEnabled = false
    }

    // Cap the size (bytes) of any single inbound response message on unary calls.
    // A larger reply is rejected with STATUS_RESOURCE_EXHAUSTED instead of being
    // buffered, protecting the client from unbounded memory use. Defaults to
    // DEFAULT_MAX_RECV_MESSAGE_BYTES (4 MiB); pass 0 to disable the limit.
    public setMaxRecvMessageBytes(maxBytes: int): void {
        this._maxRecvBytes = maxBytes
    }

    // Open a raw stream for `method` (request HEADERS sent, body not yet).
    private _open(method: string): Http2Stream {
        return this._h2.openStream(requestHeaders(method, this._authority))
    }

    // Open a raw stream carrying a per-call timeout (ms; 0 = none).
    private _openT(method: string, timeoutMs: int): Http2Stream {
        return this._h2.openStream(requestHeadersT(method, this._authority, timeoutMs))
    }

    // Open a raw stream carrying a timeout and custom request metadata.
    private _openM(method: string, timeoutMs: int, md: Metadata): Http2Stream {
        var hs: []HpackHeader = requestHeadersM(method, this._authority, timeoutMs, md)
        // Advertise the codecs we can decode, and announce our request codec.
        hs.push(hdr("grpc-accept-encoding", acceptEncodingHeader()))
        if (this._encoding == ENCODING_GZIP) {
            hs.push(hdr("grpc-encoding", "gzip"))
        }
        return this._h2.openStream(hs)
    }

    // Unary RPC: send one request, await one reply.
    public unary(method: string, message: Buffer): GrpcReply {
        return this._unaryCore(method, message, new Metadata(), 0)
    }

    // Unary RPC with a per-call timeout (ms; 0 = no deadline). On expiry the
    // stream is reset and a DEADLINE_EXCEEDED reply is returned.
    public unaryWithin(method: string, message: Buffer, timeoutMs: int): GrpcReply {
        return this._unaryCore(method, message, new Metadata(), timeoutMs)
    }

    // Unary RPC with custom request metadata.
    public unaryMeta(method: string, message: Buffer, md: Metadata): GrpcReply {
        return this._unaryCore(method, message, md, 0)
    }

    // Unary RPC with custom request metadata and a per-call timeout.
    public unaryMetaWithin(method: string, message: Buffer, md: Metadata, timeoutMs: int): GrpcReply {
        return this._unaryCore(method, message, md, timeoutMs)
    }

    private _unaryCore(method: string, message: Buffer, md: Metadata, timeoutMs: int): GrpcReply {
        if (this._statsHandlers.length == 0) {
            return this._unaryCoreInner(method, message, md, timeoutMs)
        }
        var startMs: int = time.now()
        var rep: GrpcReply = this._unaryCoreInner(method, message, md, timeoutMs)
        var endMs: int = time.now()
        var stats: RpcStats = {
            method: method,
            isClient: true,
            status: rep.status,
            startMs: startMs,
            endMs: endMs,
            durationMs: endMs - startMs,
            peerCN: "",
        }
        var i: int = 0
        while (i < this._statsHandlers.length) {
            var h: any = this._statsHandlers[i]
            h(stats)
            i = i + 1
        }
        return rep
    }

    private _unaryCoreInner(method: string, message: Buffer, md: Metadata, timeoutMs: int): GrpcReply {
        if (!this._retryEnabled) {
            return this._attemptUnary(method, message, md, timeoutMs)
        }
        var policy: RetryPolicy = this._retry
        var attempt: int = 0
        var backoff: int = policy.initialBackoffMs
        while (true) {
            var rep: GrpcReply = this._attemptUnary(method, message, md, timeoutMs)
            attempt = attempt + 1
            if (rep.status == STATUS_OK) {
                return rep
            }
            if (attempt >= policy.maxAttempts) {
                return rep
            }
            if (!_isRetryable(policy, rep.status)) {
                return rep
            }
            time.sleep(backoff)
            backoff = backoff * policy.backoffMultiplier
            if (backoff > policy.maxBackoffMs) {
                backoff = policy.maxBackoffMs
            }
        }
    }

    // Issue exactly one unary attempt: run the interceptor chain around a single
    // direct RPC. Used both for non-retried calls and as one retry attempt.
    private _attemptUnary(method: string, message: Buffer, md: Metadata, timeoutMs: int): GrpcReply {
        var terminal = function(m: string, msg: Buffer, d: Metadata): GrpcReply {
            return this._unaryDirect(m, msg, d, timeoutMs)
        }
        return _runClientUnary(this._unaryInterceptors, 0, method, message, md, terminal)
    }

    private _unaryDirect(method: string, message: Buffer, md: Metadata, timeoutMs: int): GrpcReply {
        var st: Http2Stream = this._openM(method, timeoutMs, md)
        sendEncoded(st, message, this._encoding)
        st.closeSend()
        if (timeoutMs <= 0) {
            var respData: Buffer = emptyBuf()
            var m: GrpcMessage? = st.recv()
            if (m != null) {
                respData = decodeMessage(m)
            }
            if (this._maxRecvBytes > 0 && respData.length() > this._maxRecvBytes) {
                st.reset(ERR_CANCEL)
                return mkReply(emptyBuf(), STATUS_RESOURCE_EXHAUSTED, _recvTooLargeMsg(respData.length(), this._maxRecvBytes), emptyHeaders(), emptyHeaders())
            }
            // Drain any trailing messages so the stream reaches its terminal state.
            var extra: GrpcMessage? = st.recv()
            while (extra != null) {
                extra = st.recv()
            }
            var end: Http2StreamEnd = st.result()
            return mkReply(respData, end.status, end.message, st.initialMeta, end.trailers)
        }
        var deadline: int = time.now() + timeoutMs
        var got: Buffer = emptyBuf()
        while (true) {
            var dm: GrpcMessage? = st.tryRecv()
            if (dm != null) {
                got = decodeMessage(dm)
                if (this._maxRecvBytes > 0 && got.length() > this._maxRecvBytes) {
                    st.reset(ERR_CANCEL)
                    return mkReply(emptyBuf(), STATUS_RESOURCE_EXHAUSTED, _recvTooLargeMsg(got.length(), this._maxRecvBytes), emptyHeaders(), emptyHeaders())
                }
            }
            var de: Http2StreamEnd? = st.tryResult()
            if (de != null) {
                return mkReply(got, de.status, de.message, st.initialMeta, de.trailers)
            }
            if (time.now() >= deadline) {
                st.reset(ERR_CANCEL)
                return mkReply(emptyBuf(), STATUS_DEADLINE_EXCEEDED, "deadline exceeded", emptyHeaders(), emptyHeaders())
            }
            time.sleep(1)
        }
    }

    // Server-streaming RPC: send one request, then read many responses via the
    // returned call (recv() until null, then result()).
    public serverStream(method: string, message: Buffer): GrpcClientCall {
        return this._serverStreamCore(method, message, new Metadata(), 0)
    }

    public serverStreamWithin(method: string, message: Buffer, timeoutMs: int): GrpcClientCall {
        return this._serverStreamCore(method, message, new Metadata(), timeoutMs)
    }

    // Server-streaming RPC with custom request metadata.
    public serverStreamMeta(method: string, message: Buffer, md: Metadata): GrpcClientCall {
        return this._serverStreamCore(method, message, md, 0)
    }

    private _serverStreamCore(method: string, message: Buffer, md: Metadata, timeoutMs: int): GrpcClientCall {
        var st: Http2Stream = this._openM(method, timeoutMs, md)
        sendEncoded(st, message, this._encoding)
        st.closeSend()
        var call: GrpcClientCall = new GrpcClientCall(st, this._encoding)
        if (timeoutMs > 0) {
            call._setDeadline(time.now() + timeoutMs)
        }
        return call
    }

    // Client-streaming RPC: send many requests via the returned call (send()…
        // closeSend()), then read one response (recv()) and result().
    public clientStream(method: string): GrpcClientCall {
        return this._clientStreamCore(method, new Metadata(), 0)
    }

    public clientStreamWithin(method: string, timeoutMs: int): GrpcClientCall {
        return this._clientStreamCore(method, new Metadata(), timeoutMs)
    }

    // Client-streaming RPC with custom request metadata.
    public clientStreamMeta(method: string, md: Metadata): GrpcClientCall {
        return this._clientStreamCore(method, md, 0)
    }

    private _clientStreamCore(method: string, md: Metadata, timeoutMs: int): GrpcClientCall {
        var st: Http2Stream = this._openM(method, timeoutMs, md)
        var call: GrpcClientCall = new GrpcClientCall(st, this._encoding)
        if (timeoutMs > 0) {
            call._setDeadline(time.now() + timeoutMs)
        }
        return call
    }

    // Bidirectional-streaming RPC: interleave send()/recv() on the returned call.
    public bidiStream(method: string): GrpcClientCall {
        return this._bidiStreamCore(method, new Metadata(), 0)
    }

    public bidiStreamWithin(method: string, timeoutMs: int): GrpcClientCall {
        return this._bidiStreamCore(method, new Metadata(), timeoutMs)
    }

    // Bidirectional-streaming RPC with custom request metadata.
    public bidiStreamMeta(method: string, md: Metadata): GrpcClientCall {
        return this._bidiStreamCore(method, md, 0)
    }

    private _bidiStreamCore(method: string, md: Metadata, timeoutMs: int): GrpcClientCall {
        var st: Http2Stream = this._openM(method, timeoutMs, md)
        var call: GrpcClientCall = new GrpcClientCall(st, this._encoding)
        if (timeoutMs > 0) {
            call._setDeadline(time.now() + timeoutMs)
        }
        return call
    }
}

// ─── Name resolution & client-side load balancing ──────────────────────────
// A GrpcChannel fronts a set of backend endpoints (resolved from a target) with
// a load-balancing policy, spreading calls across healthy subchannels. Each
// subchannel is an independent GrpcClient (one HTTP/2 connection per backend).
// This is client-side load balancing: there is no external proxy — the channel
// resolves addresses up front and picks a subchannel per call.

// Load-balancing policies.
export const LB_PICK_FIRST: int = 0    // always the first ready subchannel (failover only)
export const LB_ROUND_ROBIN: int = 1   // rotate across ready subchannels per call

// Health checking (M15): standard grpc.health.v1.Health method paths. Declared
// here so GrpcChannel.refreshHealth (below) can reference the ServingStatus enum.
export const HEALTH_PATH_CHECK: string = "/grpc.health.v1.Health/Check"
export const HEALTH_PATH_WATCH: string = "/grpc.health.v1.Health/Watch"

// ServingStatus enum (HealthCheckResponse.status).
export const SERVING_UNKNOWN: int = 0
export const SERVING_SERVING: int = 1
export const SERVING_NOT_SERVING: int = 2
export const SERVING_SERVICE_UNKNOWN: int = 3

// A resolved backend address.
export dataType Endpoint {
    host: string;
    port: int;
}

// Build an Endpoint.
export function mkEndpoint(host: string, port: int): Endpoint {
    var e: Endpoint = { host: host, port: port }
    return e
}

// Static name resolver: parse a comma-separated "host:port,host:port" target
// into a list of endpoints. Whitespace around entries is tolerated; an entry
// without a port is skipped. This is the built-in resolver; richer resolvers
// (DNS, service discovery) can produce []Endpoint and feed a GrpcChannel too.
export function resolveStatic(target: string): []Endpoint {
    var out: []Endpoint = []
    var b: Buffer = Buffer.fromString(target)
    var n: int = b.length()
    var hostBytes: []any = []
    var port: int = 0
    var sawColon: bool = false
    var i: int = 0
    while (i <= n) {
        var c: int = -1
        if (i < n) {
            c = b.getByte(i)
        }
        if (i == n || c == 44) {                 // ',' or end of string
            if (sawColon && hostBytes.length > 0 && port > 0) {
                out.push(mkEndpoint(Buffer.fromArray(hostBytes).toStringUtf8(), port))
            }
            hostBytes = []
            port = 0
            sawColon = false
        } else if (c == 58) {                    // ':'
        sawColon = true
    } else if (c == 32 || c == 9) {          // skip spaces/tabs
    i = i + 1
    continue
} else if (sawColon) {
    if (c >= 48 && c <= 57) {            // accumulate port digits
        port = port * 10 + (c - 48)
    }
} else {
    hostBytes.push(c)                    // accumulate host bytes
}
i = i + 1
}
return out
}

export class GrpcChannel {
    var _clients: []GrpcClient    // one live subchannel per reachable endpoint
    var _serving: []bool          // health state per subchannel (true = eligible)
    var _policy: int
    var _next: int                // round-robin cursor
    var _resolved: int            // number of endpoints the resolver produced

    // Resolve `target` ("host:port,host:port"), dial every endpoint, and load
    // balance calls across the reachable ones using `policy`. Endpoints that
    // fail to connect are skipped (the channel still serves from the rest).
    // Pass tlsOptions to dial each subchannel over TLS/mTLS (see GrpcClient).
    constructor(target: string, policy: int, tlsOptions: any?) {
        var endpoints: []Endpoint = resolveStatic(target)
        this._resolved = endpoints.length
        this._clients = []
        this._serving = []
        this._policy = policy
        this._next = 0
        var i: int = 0
        while (i < endpoints.length) {
            var ep: Endpoint = endpoints[i]
            try {
                var c: GrpcClient = new GrpcClient(ep.host, ep.port, tlsOptions)
                this._clients.push(c)
                this._serving.push(true)
            } catch (e) {
                // Unreachable endpoint — exclude it from the working set.
            }
            i = i + 1
        }
    }

    // Number of endpoints the resolver produced (reachable or not).
    public endpointCount(): int {
        return this._resolved
    }

    // Number of live subchannels (endpoints that connected successfully).
    public subchannelCount(): int {
        return this._clients.length
    }

    // Number of subchannels currently eligible to serve (live AND serving).
    public readyCount(): int {
        var n: int = 0
        var i: int = 0
        while (i < this._serving.length) {
            if (this._serving[i]) {
                n = n + 1
            }
            i = i + 1
        }
        return n
    }

    // Pick the next eligible subchannel index for the active policy, or -1 if
    // none are serving. Round-robin advances the cursor and skips unhealthy
    // subchannels; pick-first returns the first serving subchannel.
    private _pick(): int {
        var n: int = this._clients.length
        if (n == 0) {
            return -1
        }
        if (this._policy == LB_PICK_FIRST) {
            var i: int = 0
            while (i < n) {
                if (this._serving[i]) {
                    return i
                }
                i = i + 1
            }
            return -1
        }
        var tries: int = 0
        while (tries < n) {
            var idx: int = this._next % n
            this._next = (this._next + 1) % n
            if (this._serving[idx]) {
                return idx
            }
            tries = tries + 1
        }
        return -1
    }

    // Reply returned when no subchannel is available to serve a call.
    private _noSubchannel(): GrpcReply {
        return mkReply(emptyBuf(), STATUS_UNAVAILABLE, "no available subchannel", emptyHeaders(), emptyHeaders())
    }

    // Unary RPC routed to a load-balanced subchannel.
    public unary(method: string, message: Buffer): GrpcReply {
        var idx: int = this._pick()
        if (idx < 0) {
            return this._noSubchannel()
        }
        var c: GrpcClient = this._clients[idx]
        return c.unary(method, message)
    }

    // Unary RPC with a per-call timeout, routed to a subchannel.
    public unaryWithin(method: string, message: Buffer, timeoutMs: int): GrpcReply {
        var idx: int = this._pick()
        if (idx < 0) {
            return this._noSubchannel()
        }
        var c: GrpcClient = this._clients[idx]
        return c.unaryWithin(method, message, timeoutMs)
    }

    // Unary RPC with custom request metadata, routed to a subchannel.
    public unaryMeta(method: string, message: Buffer, md: Metadata): GrpcReply {
        var idx: int = this._pick()
        if (idx < 0) {
            return this._noSubchannel()
        }
        var c: GrpcClient = this._clients[idx]
        return c.unaryMeta(method, message, md)
    }

    // Server-streaming RPC routed to a subchannel.
    public serverStream(method: string, message: Buffer): GrpcClientCall {
        var idx: int = this._pick()
        if (idx < 0) {
            throw "no available subchannel"
        }
        var c: GrpcClient = this._clients[idx]
        return c.serverStream(method, message)
    }

    // Client-streaming RPC routed to a subchannel.
    public clientStream(method: string): GrpcClientCall {
        var idx: int = this._pick()
        if (idx < 0) {
            throw "no available subchannel"
        }
        var c: GrpcClient = this._clients[idx]
        return c.clientStream(method)
    }

    // Bidirectional-streaming RPC routed to a subchannel.
    public bidiStream(method: string): GrpcClientCall {
        var idx: int = this._pick()
        if (idx < 0) {
            throw "no available subchannel"
        }
        var c: GrpcClient = this._clients[idx]
        return c.bidiStream(method)
    }

    // Apply a request codec ("gzip" | "identity") to every subchannel.
    public setCompression(encoding: string): void {
        var i: int = 0
        while (i < this._clients.length) {
            this._clients[i].setCompression(encoding)
            i = i + 1
        }
    }

    // Apply a retry policy to every subchannel.
    public setRetryPolicy(policy: RetryPolicy): void {
        var i: int = 0
        while (i < this._clients.length) {
            this._clients[i].setRetryPolicy(policy)
            i = i + 1
        }
    }

    // Enable HTTP/2 keepalive on every subchannel.
    public enableKeepalive(timeMs: int, timeoutMs: int): void {
        var i: int = 0
        while (i < this._clients.length) {
            this._clients[i].enableKeepalive(timeMs, timeoutMs)
            i = i + 1
        }
    }

    // Probe each subchannel's health (M15) and update its eligibility: a
    // subchannel is kept in the rotation only while it reports SERVING for
    // `service` (use "" for overall server health). Call periodically to make
    // load balancing health-aware so calls avoid NOT_SERVING backends.
    public refreshHealth(service: string): void {
        var i: int = 0
        while (i < this._clients.length) {
            var hc: HealthClient = new HealthClient(this._clients[i])
            this._serving[i] = (hc.check(service) == SERVING_SERVING)
            i = i + 1
        }
    }

    // Close every subchannel.
    public close(): void {
        var i: int = 0
        while (i < this._clients.length) {
            this._clients[i].close()
            i = i + 1
        }
    }
}

// ─── Health checking (grpc.health.v1.Health) ───────────────────────────────
// The standard gRPC health-checking protocol. A server hosts a Health service
// that reports per-service serving status; clients probe it with Check (unary)
// or Watch (server-streaming). Service "" denotes the whole server. Used on its
// own for readiness probes, and by GrpcChannel.refreshHealth for health-aware
// load balancing.

// HealthCheckRequest { string service = 1; } encode/decode.
function encodeHealthRequest(service: string): Buffer {
    var w: ProtoWriter = new ProtoWriter()
    if (service.length > 0) {
        w.writeString(1, service)
    }
    return w.toBuffer()
}

function decodeHealthService(data: Buffer): string {
    var r: ProtoReader = new ProtoReader(data)
    var out: string = ""
    while (r.hasMore()) {
        var tag: ProtoTag = r.readTag()
        if (tag.field == 1 && tag.wireType == PB_LEN) {
            out = r.readString()
        } else {
            r.skip(tag.wireType)
        }
    }
    return out
}

// HealthCheckResponse { ServingStatus status = 1; } encode/decode.
function encodeHealthResponse(status: int): Buffer {
    var w: ProtoWriter = new ProtoWriter()
    w.writeInt32(1, status)
    return w.toBuffer()
}

function decodeHealthStatus(data: Buffer): int {
    var r: ProtoReader = new ProtoReader(data)
    var st: int = SERVING_UNKNOWN
    while (r.hasMore()) {
        var tag: ProtoTag = r.readTag()
        if (tag.field == 1 && tag.wireType == PB_VARINT) {
            st = r.readVarint()
        } else {
            r.skip(tag.wireType)
        }
    }
    return st
}

// Server-side health registry. Tracks a serving status per service name; the
// empty name "" is the overall server status (defaults to SERVING). Register it
// on a GrpcServer with registerHealthService(server, health).
export class HealthService {
    var _status: map[string]int

    constructor() {
        this._status = {}
        this._status[""] = SERVING_SERVING
    }

    // Set the serving status for `service` ("" = whole server).
    public setServingStatus(service: string, status: int): void {
        this._status[service] = status
    }

    // Mark `service` as SERVING.
    public setServing(service: string): void {
        this._status[service] = SERVING_SERVING
    }

    // Mark `service` as NOT_SERVING.
    public setNotServing(service: string): void {
        this._status[service] = SERVING_NOT_SERVING
    }

    // Current status for `service`, or SERVICE_UNKNOWN if never registered.
    public statusOf(service: string): int {
        if (this._status.has(service)) {
            return this._status[service]
        }
        return SERVING_SERVICE_UNKNOWN
    }

    // Unary Check handler: returns the service's status, or NOT_FOUND when the
    // service is unknown (per the health protocol).
    public check(req: GrpcRequest): GrpcResponse {
        var service: string = decodeHealthService(req.data)
        var st: int = this.statusOf(service)
        if (st == SERVING_SERVICE_UNKNOWN) {
            return grpcError(STATUS_NOT_FOUND, "unknown service: " + service)
        }
        return grpcOk(encodeHealthResponse(st))
    }

    // Server-streaming Watch handler: emits the current status once. (A full
        // Watch streams status changes over time; this reports the present state,
        // which covers readiness probing and health-aware load balancing.)
    public watch(req: GrpcRequest, stream: GrpcServerStream): void {
        var service: string = decodeHealthService(req.data)
        stream.send(encodeHealthResponse(this.statusOf(service)))
    }
}

// Register a HealthService on `server` at the standard health method paths.
// Module-level (not a HealthService method) so the handler closures run in a
// non-class frame and only touch the service's public surface.
export function registerHealthService(server: GrpcServer, health: HealthService): void {
    server.register(HEALTH_PATH_CHECK, function(req: GrpcRequest): GrpcResponse {
        return health.check(req)
    })
    server.registerServerStream(HEALTH_PATH_WATCH, function(req: GrpcRequest, stream: GrpcServerStream): void {
        health.watch(req, stream)
    })
}

// Client-side health probe over an existing GrpcClient subchannel.
export class HealthClient {
    var _client: GrpcClient

    constructor(client: GrpcClient) {
        this._client = client
    }

    // Probe `service` ("" = whole server). Returns a ServingStatus; a failed
    // RPC (e.g. server without a health service, or NOT_FOUND) maps to
    // SERVICE_UNKNOWN so callers can treat it as "not serving".
    public check(service: string): int {
        var rep: GrpcReply = this._client.unary(HEALTH_PATH_CHECK, encodeHealthRequest(service))
        if (rep.status != STATUS_OK) {
            return SERVING_SERVICE_UNKNOWN
        }
        return decodeHealthStatus(rep.data)
    }

    // Convenience: true only when `service` reports SERVING.
    public isServing(service: string): bool {
        return this.check(service) == SERVING_SERVING
    }
}

// ─── Server reflection (grpc.reflection.v1alpha.ServerReflection) ───────────
// The standard gRPC reflection protocol lets tools like grpcurl discover the
// services a server hosts at runtime without a local .proto. It is a single
// bidirectional-streaming RPC, ServerReflectionInfo, where each request names
// one query and the server replies with the matching response.
//
// This implements the list_services query — the one grpcurl uses for
// `grpcurl <addr> list` and for interop discovery (M20). Descriptor queries
// (file_by_filename, file_containing_symbol, …) require full FileDescriptorProto
// encoding, which is out of scope here; those are answered honestly with an
// UNIMPLEMENTED ErrorResponse rather than a wrong descriptor.

// The reflection v1alpha bidi-streaming method path.
export const REFLECTION_V1ALPHA_PATH: string = "/grpc.reflection.v1alpha.ServerReflection/ServerReflectionInfo"

// ServerReflectionRequest.message_request oneof field numbers.
export const REFLECT_FILE_BY_FILENAME: int = 3
export const REFLECT_FILE_CONTAINING_SYMBOL: int = 4
export const REFLECT_ALL_EXTENSION_NUMBERS: int = 6
export const REFLECT_LIST_SERVICES: int = 7

// A decoded ServerReflectionRequest: `kind` is the field number of the
// message_request oneof that was set (0 = none), `value` its string payload.
export dataType ReflectionRequest {
    host: string;
    kind: int;
    value: string;
}

// Extract the service name from a full method path "/pkg.Service/Method".
// ASCII byte scan (service names are ASCII) avoids rune/byte index pitfalls.
function _serviceNameFromPath(path: string): string {
    var b: Buffer = Buffer.fromString(path)
    var n: int = b.length()
    var start: int = 0
    if (n > 0 && b.getByte(0) == 47) {   // leading '/'
        start = 1
    }
    var out: []any = []
    var i: int = start
    while (i < n) {
        var c: int = b.getByte(i)
        if (c == 47) {   // next '/' ends the service name
            break
        }
        out.push(c)
        i = i + 1
    }
    return Buffer.fromArray(out).toStringUtf8()
}

// Decode a ServerReflectionRequest. host = field 1; the message_request oneof is
// any of fields 3/4/6/7 (all length-delimited strings here).
function decodeReflectionRequest(data: Buffer): ReflectionRequest {
    var r: ProtoReader = new ProtoReader(data)
    var host: string = ""
    var kind: int = 0
    var value: string = ""
    while (r.hasMore()) {
        var tag: ProtoTag = r.readTag()
        if (tag.field == 1 && tag.wireType == PB_LEN) {
            host = r.readString()
        } else if (tag.wireType == PB_LEN && (tag.field == REFLECT_FILE_BY_FILENAME || tag.field == REFLECT_FILE_CONTAINING_SYMBOL || tag.field == REFLECT_ALL_EXTENSION_NUMBERS || tag.field == REFLECT_LIST_SERVICES)) {
            kind = tag.field
            value = r.readString()
        } else {
            r.skip(tag.wireType)
        }
    }
    var out: ReflectionRequest = { host: host, kind: kind, value: value }
    return out
}

// Encode a list_services request (message_request = list_services, field 7).
// The conventional payload is "*" (list everything).
function encodeListServicesRequest(): Buffer {
    var w: ProtoWriter = new ProtoWriter()
    w.writeString(REFLECT_LIST_SERVICES, "*")
    return w.toBuffer()
}

// Encode a ServerReflectionResponse carrying a ListServiceResponse (field 6):
//   ListServiceResponse { repeated ServiceResponse service = 1; }
//   ServiceResponse     { string name = 1; }
// `rawRequest` is echoed back as original_request (field 2).
function encodeListServices(rawRequest: Buffer, host: string, services: []string): Buffer {
    var list: ProtoWriter = new ProtoWriter()
    var i: int = 0
    while (i < services.length) {
        var svc: ProtoWriter = new ProtoWriter()
        svc.writeString(1, services[i])   // ServiceResponse.name = 1
        list.writeMessage(1, svc)         // ListServiceResponse.service = 1 (repeated)
        i = i + 1
    }
    var resp: ProtoWriter = new ProtoWriter()
    if (host.length > 0) {
        resp.writeString(1, host)         // valid_host = 1
    }
    resp.writeBytes(2, rawRequest)        // original_request = 2 (echo)
    resp.writeMessage(6, list)            // list_services_response = 6
    return resp.toBuffer()
}

// Encode a ServerReflectionResponse carrying an ErrorResponse (field 7):
//   ErrorResponse { int32 error_code = 1; string error_message = 2; }
function encodeReflectionError(rawRequest: Buffer, host: string, code: int, message: string): Buffer {
    var err: ProtoWriter = new ProtoWriter()
    err.writeInt32(1, code)               // error_code = 1
    err.writeString(2, message)           // error_message = 2
    var resp: ProtoWriter = new ProtoWriter()
    if (host.length > 0) {
        resp.writeString(1, host)
    }
    resp.writeBytes(2, rawRequest)
    resp.writeMessage(7, err)             // error_response = 7
    return resp.toBuffer()
}

// Decode the service names from a ListServiceResponse-bearing
// ServerReflectionResponse (field 6 → repeated ServiceResponse, name = field 1).
function decodeListServicesResponse(data: Buffer): []string {
    var r: ProtoReader = new ProtoReader(data)
    var out: []string = []
    while (r.hasMore()) {
        var tag: ProtoTag = r.readTag()
        if (tag.field == 6 && tag.wireType == PB_LEN) {
            var list: ProtoReader = r.readMessage()
            while (list.hasMore()) {
                var lt: ProtoTag = list.readTag()
                if (lt.field == 1 && lt.wireType == PB_LEN) {
                    var svc: ProtoReader = list.readMessage()
                    while (svc.hasMore()) {
                        var st: ProtoTag = svc.readTag()
                        if (st.field == 1 && st.wireType == PB_LEN) {
                            out.push(svc.readString())
                        } else {
                            svc.skip(st.wireType)
                        }
                    }
                } else {
                    list.skip(lt.wireType)
                }
            }
        } else {
            r.skip(tag.wireType)
        }
    }
    return out
}

// Server-side reflection service. Advertises a set of fully-qualified service
// names; register it on a GrpcServer with registerReflectionService(server, r).
// The reflection service itself is always advertised.
export class ReflectionService {
    var _services: []string

    constructor() {
        var s: []string = []
        this._services = s
        this._services.push("grpc.reflection.v1alpha.ServerReflection")
    }

    // Advertise a fully-qualified service name (e.g. "pkg.Service"). Idempotent.
    public addService(name: string): void {
        var i: int = 0
        while (i < this._services.length) {
            if (this._services[i] == name) {
                return
            }
            i = i + 1
        }
        this._services.push(name)
    }

    // Advertise every service derived from a server's registered method paths.
    public addServerServices(server: GrpcServer): void {
        var names: []string = server.serviceNames()
        var i: int = 0
        while (i < names.length) {
            this.addService(names[i])
            i = i + 1
        }
    }

    // The advertised service names.
    public services(): []string {
        return this._services
    }

    // Bidi handler for ServerReflectionInfo: answer each request until the
    // client half-closes. list_services is fully supported; other queries get
    // an UNIMPLEMENTED ErrorResponse.
    public serve(stream: GrpcServerStream): void {
        while (true) {
            var msg: Buffer? = stream.recv()
            if (msg != null) {
                var req: ReflectionRequest = decodeReflectionRequest(msg)
                if (req.kind == REFLECT_LIST_SERVICES) {
                    stream.send(encodeListServices(msg, req.host, this._services))
                } else {
                    stream.send(encodeReflectionError(msg, req.host, STATUS_UNIMPLEMENTED, "reflection request not supported: only list_services"))
                }
            } else {
                return
            }
        }
    }
}

// Register a ReflectionService on `server` at the reflection method path.
// Module-level (like registerHealthService) so the handler closure runs in a
// non-class frame and only touches the service's public surface.
export function registerReflectionService(server: GrpcServer, refl: ReflectionService): void {
    server.registerBidiStream(REFLECTION_V1ALPHA_PATH, function(stream: GrpcServerStream): void {
        refl.serve(stream)
    })
}

// Client-side reflection probe over an existing GrpcClient.
export class ReflectionClient {
    var _client: GrpcClient

    constructor(client: GrpcClient) {
        this._client = client
    }

    // List the services advertised by the server (reflection list_services).
    public listServices(): []string {
        var call: GrpcClientCall = this._client.bidiStream(REFLECTION_V1ALPHA_PATH)
        call.send(encodeListServicesRequest())
        call.closeSend()
        var out: []string = []
        var m: Buffer? = call.recv()
        if (m != null) {
            out = decodeListServicesResponse(m)
        }
        var extra: Buffer? = call.recv()
        while (extra != null) {
            extra = call.recv()
        }
        call.result()
        return out
    }
}
