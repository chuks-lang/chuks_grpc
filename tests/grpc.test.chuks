// ─── chuks_grpc · end-to-end gRPC (h2c) round-trip tests ───────────────────
// Spins up a real in-process gRPC server on an ephemeral port and drives it
// with the gRPC client over a live TCP/HTTP-2 connection.

import { test } from "std/test"
import { Buffer } from "std/buffer"
import { time } from "std/time"
import { Channel } from "std/channel"
import {
    GrpcServer, GrpcClient, GrpcRequest, GrpcResponse, GrpcReply,
    GrpcServerStream, GrpcClientCall,
    Metadata, metadataFromHeaders,
    grpcOk, grpcError, grpcErrorWithDetails, mkErrorDetail, ErrorDetail,
    RetryPolicy, defaultRetryPolicy,
    GrpcChannel, Endpoint, mkEndpoint, resolveStatic, LB_PICK_FIRST, LB_ROUND_ROBIN,
    HealthService, HealthClient, registerHealthService,
    SERVING_SERVING, SERVING_NOT_SERVING, SERVING_SERVICE_UNKNOWN,
    ReflectionService, ReflectionClient, registerReflectionService,
    RpcStats,
    STATUS_OK, STATUS_UNIMPLEMENTED, STATUS_DEADLINE_EXCEEDED, STATUS_CANCELLED, STATUS_UNAUTHENTICATED,
    STATUS_UNAVAILABLE, STATUS_INVALID_ARGUMENT
} from "../src/index.chuks"
import { ProtoWriter, ProtoReader, ProtoTag, PB_LEN } from "../src/protobuf.chuks"
import { tlsSelfSigned } from "std/net"

var passed: any = 0
var failed: any = 0

// Parse the port out of a "host:port" address string.
function portOf(addr: string): int {
    var b: Buffer = Buffer.fromString(addr)
    var n: int = b.length()
    var colon: int = -1
    var i: int = 0
    while (i < n) {
        if (b.getByte(i) == 58) { colon = i }   // ':'
        i = i + 1
    }
    var val: int = 0
    var j: int = colon + 1
    while (j < n) {
        var c: int = b.getByte(j)
        if (c >= 48 && c <= 57) { val = val * 10 + (c - 48) }
        j = j + 1
    }
    return val
}

// Encode a protobuf message { field 1: string }.
function encodeName(name: string): Buffer {
    var w: ProtoWriter = new ProtoWriter()
    w.writeString(1, name)
    return w.toBuffer()
}

// Decode field 1 (string) from a protobuf message.
function decodeName(data: Buffer): string {
    var r: ProtoReader = new ProtoReader(data)
    var out: string = ""
    while (r.hasMore()) {
        var tag: ProtoTag = r.readTag()
        if (tag.field == 1 && tag.wireType == PB_LEN) {
            out = r.readString()
        } else {
            r.skip(tag.wireType)
        }
    }
    return out
}

// Handler: Echo.Say(name) -> "hello, " + name
function sayHandler(req: GrpcRequest): GrpcResponse {
    var name: string = decodeName(req.data)
    return grpcOk(encodeName("hello, " + name))
}

// Server-streaming handler: one request "name" -> three messages name0/1/2.
function countHandler(req: GrpcRequest, stream: GrpcServerStream): void {
    var name: string = decodeName(req.data)
    var i: int = 0
    while (i < 3) {
        stream.send(encodeName(name + string(i)))
        i = i + 1
    }
}

// Client-streaming handler: drain all requests -> one reply "count=N".
function collectHandler(stream: GrpcServerStream): GrpcResponse {
    var count: int = 0
    var m: Buffer? = stream.recv()
    while (m != null) {
        count = count + 1
        m = stream.recv()
    }
    return grpcOk(encodeName("count=" + string(count)))
}

// Bidirectional handler: echo each request back as "echo:<name>".
function chatHandler(stream: GrpcServerStream): void {
    var m: Buffer? = stream.recv()
    while (m != null) {
        stream.send(encodeName("echo:" + decodeName(m)))
        m = stream.recv()
    }
}

// Slow unary handler: sleeps past a short client deadline before replying.
function slowHandler(req: GrpcRequest): GrpcResponse {
    time.sleep(300)
    return grpcOk(encodeName("late"))
}

// Reports whether the server observed a client deadline on the request.
function deadlineEchoHandler(req: GrpcRequest): GrpcResponse {
    if (req.deadlineMs > 0) {
        return grpcOk(encodeName("has-deadline"))
    }
    return grpcOk(encodeName("no-deadline"))
}

// Signals out of the cancel-watch handler whether it observed cancellation.
var cancelSignal: Channel<bool> = new Channel<bool>(1)

// Server-streaming handler that emits "started", then polls for cancellation
// and reports (true once the client cancels, false if it times out waiting).
function watchHandler(req: GrpcRequest, stream: GrpcServerStream): void {
    stream.send(encodeName("started"))
    var i: int = 0
    while (i < 2000) {
        if (stream.cancelled()) {
            cancelSignal.send(true)
            return
        }
        time.sleep(2)
        i = i + 1
    }
    cancelSignal.send(false)
}

// Unary handler: reads request metadata "x-user" and echoes it back.
function metaUnaryHandler(req: GrpcRequest): GrpcResponse {
    var user: string = metadataFromHeaders(req.metadata).get("x-user")
    return grpcOk(encodeName("u=" + user))
}

// Server-streaming handler: reads request metadata, sets a custom response
// header and trailer, and echoes the caller's "x-user" value once.
function metaStreamHandler(req: GrpcRequest, stream: GrpcServerStream): void {
    var user: string = stream.requestMetadata().get("x-user")
    stream.setHeader("x-server", "v1")
    stream.send(encodeName("user=" + user))
    stream.setTrailer("x-trailer", "done")
}

// Server-streaming handler that reports the negotiated request/response codecs
// ("gzip" | "identity") so the client can assert the negotiation outcome.
function encReportHandler(req: GrpcRequest, stream: GrpcServerStream): void {
    stream.send(encodeName("req=" + stream.requestEncoding() + ";resp=" + stream.responseEncoding()))
}

// Unary handler returning a large, highly compressible payload.
function bigHandler(req: GrpcRequest): GrpcResponse {
    var s: string = ""
    var i: int = 0
    while (i < 200) {
        s = s + "abcdefghij"
        i = i + 1
    }
    return grpcOk(encodeName(s))
}

// Run a single connection's worth of serving on a background task.
async function runServer(srv: GrpcServer): Task<void> {
    srv.serveOnce()
}

// Unary handler that echoes the peer's mTLS certificate Common Name, so the
// client can assert the server authenticated it (cn=chuks for our self-signed
    // cert, cn= for plaintext / server-only TLS).
function peerHandler(req: GrpcRequest): GrpcResponse {
    return grpcOk(encodeName("cn=" + req.peerCN))
}

// ── Interceptor fixtures (M11) ──────────────────────────────────────────────

// Server unary interceptor that wraps the response body in "A(...)".
function wrapA(req: GrpcRequest, next: any): GrpcResponse {
    var resp: GrpcResponse = next(req)
    return grpcOk(encodeName("A(" + decodeName(resp.data) + ")"))
}

// Server unary interceptor that wraps the response body in "B(...)".
function wrapB(req: GrpcRequest, next: any): GrpcResponse {
    var resp: GrpcResponse = next(req)
    return grpcOk(encodeName("B(" + decodeName(resp.data) + ")"))
}

// Server unary interceptor that short-circuits with UNAUTHENTICATED, never
// calling `next` (so the handler must not run).
function denyAuth(req: GrpcRequest, next: any): GrpcResponse {
    return grpcError(STATUS_UNAUTHENTICATED, "no token")
}

// Client unary interceptor that appends "!" to the request message before
// issuing the RPC.
function bangRequest(method: string, message: Buffer, md: Metadata, next: any): GrpcReply {
    return next(method, encodeName(decodeName(message) + "!"), md)
}

// Client unary interceptor that wraps the reply body in "wrapped:...".
function wrapReply(method: string, message: Buffer, md: Metadata, next: any): GrpcReply {
    var rep: GrpcReply = next(method, message, md)
    var out: GrpcReply = { data: encodeName("wrapped:" + decodeName(rep.data)), status: rep.status, message: rep.message, headers: rep.headers, trailers: rep.trailers, details: rep.details }
    return out
}

// Server stream interceptor that tags the response with a header, then proceeds.
function tagStream(stream: GrpcServerStream, next: any): void {
    stream.setHeader("x-intercepted", "yes")
    next(stream)
}

// ── Retry fixtures (M13) ────────────────────────────────────────────────────
// Per-test call counters (each test uses a fresh server, so a module-level
    // counter is reset explicitly before the test by assigning back to 0).
var flaky29: any = 0
var flaky30: any = 0
var flaky31: any = 0

// Fails the first two attempts with UNAVAILABLE, then succeeds — exercises a
// retry that eventually recovers.
function flakyHandler(req: GrpcRequest): GrpcResponse {
    flaky29 = flaky29 + 1
    if (flaky29 < 3) {
        return grpcError(STATUS_UNAVAILABLE, "try again")
    }
    return grpcOk(encodeName("recovered"))
}

// Always fails with a non-retryable status; the client must NOT retry.
function badArgHandler(req: GrpcRequest): GrpcResponse {
    flaky30 = flaky30 + 1
    return grpcError(STATUS_INVALID_ARGUMENT, "bad arg")
}

// Always fails with a retryable status; retries should be exhausted.
function alwaysDownHandler(req: GrpcRequest): GrpcResponse {
    flaky31 = flaky31 + 1
    return grpcError(STATUS_UNAVAILABLE, "down")
}

// 1 — unary round-trip echo
try {
    var srv: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv.register("/echo.Echo/Say", sayHandler)
    var port: int = portOf(srv.addr())
    var t: Task<void> = spawn runServer(srv)

    var client: GrpcClient = new GrpcClient("127.0.0.1", port)
    var reply: GrpcReply = client.unary("/echo.Echo/Say", encodeName("world"))
    test.assertEqual(reply.status, STATUS_OK)
    test.assertEqual(decodeName(reply.data), "hello, world")
    client.close()
    await t
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 1 unary echo — " + string(e)) }

// 2 — unknown method -> UNIMPLEMENTED trailers-only response
try {
    var srv2: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv2.register("/echo.Echo/Say", sayHandler)
    var port2: int = portOf(srv2.addr())
    var t2: Task<void> = spawn runServer(srv2)

    var client2: GrpcClient = new GrpcClient("127.0.0.1", port2)
    var reply2: GrpcReply = client2.unary("/echo.Echo/Missing", encodeName("x"))
    test.assertEqual(reply2.status, STATUS_UNIMPLEMENTED)
    client2.close()
    await t2
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 2 unimplemented — " + string(e)) }

// 3 — empty request message round-trips
try {
    var srv3: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv3.register("/echo.Echo/Say", sayHandler)
    var port3: int = portOf(srv3.addr())
    var t3: Task<void> = spawn runServer(srv3)

    var client3: GrpcClient = new GrpcClient("127.0.0.1", port3)
    var reply3: GrpcReply = client3.unary("/echo.Echo/Say", encodeName(""))
    test.assertEqual(reply3.status, STATUS_OK)
    test.assertEqual(decodeName(reply3.data), "hello, ")
    client3.close()
    await t3
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 3 empty message — " + string(e)) }

// 4 — server-streaming: one request fans out to three responses
try {
    var srv4: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv4.registerServerStream("/echo.Echo/Count", countHandler)
    var port4: int = portOf(srv4.addr())
    var t4: Task<void> = spawn runServer(srv4)

    var client4: GrpcClient = new GrpcClient("127.0.0.1", port4)
    var call4: GrpcClientCall = client4.serverStream("/echo.Echo/Count", encodeName("x"))
    var acc4: string = ""
    var m4: Buffer? = call4.recv()
    while (m4 != null) {
        acc4 = acc4 + decodeName(m4) + ","
        m4 = call4.recv()
    }
    var rep4: GrpcReply = call4.result()
    test.assertEqual(rep4.status, STATUS_OK)
    test.assertEqual(acc4, "x0,x1,x2,")
    client4.close()
    await t4
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 4 server-stream — " + string(e)) }

// 5 — client-streaming: three requests aggregate into one reply
try {
    var srv5: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv5.registerClientStream("/echo.Echo/Collect", collectHandler)
    var port5: int = portOf(srv5.addr())
    var t5: Task<void> = spawn runServer(srv5)

    var client5: GrpcClient = new GrpcClient("127.0.0.1", port5)
    var call5: GrpcClientCall = client5.clientStream("/echo.Echo/Collect")
    call5.send(encodeName("a"))
    call5.send(encodeName("b"))
    call5.send(encodeName("c"))
    call5.closeSend()
    var got5: string = ""
    var m5: Buffer? = call5.recv()
    if (m5 != null) {
        got5 = decodeName(m5)
    }
    var rep5: GrpcReply = call5.result()
    test.assertEqual(rep5.status, STATUS_OK)
    test.assertEqual(got5, "count=3")
    client5.close()
    await t5
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 5 client-stream — " + string(e)) }

// 6 — bidirectional streaming: three requests echoed back interleaved
try {
    var srv6: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv6.registerBidiStream("/echo.Echo/Chat", chatHandler)
    var port6: int = portOf(srv6.addr())
    var t6: Task<void> = spawn runServer(srv6)

    var client6: GrpcClient = new GrpcClient("127.0.0.1", port6)
    var call6: GrpcClientCall = client6.bidiStream("/echo.Echo/Chat")
    call6.send(encodeName("1"))
    call6.send(encodeName("2"))
    call6.send(encodeName("3"))
    call6.closeSend()
    var acc6: string = ""
    var m6: Buffer? = call6.recv()
    while (m6 != null) {
        acc6 = acc6 + decodeName(m6) + ","
        m6 = call6.recv()
    }
    var rep6: GrpcReply = call6.result()
    test.assertEqual(rep6.status, STATUS_OK)
    test.assertEqual(acc6, "echo:1,echo:2,echo:3,")
    client6.close()
    await t6
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 6 bidi-stream — " + string(e)) }

// 7 — client deadline fires: slow server, short timeout -> DEADLINE_EXCEEDED
try {
    var srv7: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv7.register("/echo.Echo/Slow", slowHandler)
    var port7: int = portOf(srv7.addr())
    var t7: Task<void> = spawn runServer(srv7)

    var client7: GrpcClient = new GrpcClient("127.0.0.1", port7)
    var rep7: GrpcReply = client7.unaryWithin("/echo.Echo/Slow", encodeName("x"), 50)
    test.assertEqual(rep7.status, STATUS_DEADLINE_EXCEEDED)
    client7.close()
    await t7
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 7 deadline fires — " + string(e)) }

// 8 — under deadline: fast server, generous timeout -> OK
try {
    var srv8: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv8.register("/echo.Echo/Say", sayHandler)
    var port8: int = portOf(srv8.addr())
    var t8: Task<void> = spawn runServer(srv8)

    var client8: GrpcClient = new GrpcClient("127.0.0.1", port8)
    var rep8: GrpcReply = client8.unaryWithin("/echo.Echo/Say", encodeName("ada"), 5000)
    test.assertEqual(rep8.status, STATUS_OK)
    test.assertEqual(decodeName(rep8.data), "hello, ada")
    client8.close()
    await t8
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 8 under deadline — " + string(e)) }

// 9 — server observes the propagated grpc-timeout header
try {
    var srv9: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv9.register("/echo.Echo/Deadline", deadlineEchoHandler)
    var port9: int = portOf(srv9.addr())
    var t9: Task<void> = spawn runServer(srv9)

    var client9: GrpcClient = new GrpcClient("127.0.0.1", port9)
    var rep9: GrpcReply = client9.unaryWithin("/echo.Echo/Deadline", encodeName("x"), 5000)
    test.assertEqual(rep9.status, STATUS_OK)
    test.assertEqual(decodeName(rep9.data), "has-deadline")
    client9.close()
    await t9
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 9 server deadline header — " + string(e)) }

// 10 — server observes client cancellation via stream.cancelled()
try {
    var srv10: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv10.registerServerStream("/echo.Echo/Watch", watchHandler)
    var port10: int = portOf(srv10.addr())
    var t10: Task<void> = spawn runServer(srv10)

    var client10: GrpcClient = new GrpcClient("127.0.0.1", port10)
    var call10: GrpcClientCall = client10.serverStream("/echo.Echo/Watch", encodeName("go"))
    var first10: Buffer? = call10.recv()
    var firstName10: string = ""
    if (first10 != null) { firstName10 = decodeName(first10) }
    test.assertEqual(firstName10, "started")
    call10.cancel()
    var saw10: bool? = cancelSignal.receive()
    test.assertEqual(saw10, true)
    client10.close()
    await t10
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 10 server observes cancel — " + string(e)) }

// 11 — client cancel(): result() returns CANCELLED promptly
try {
    var srv11: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv11.registerServerStream("/echo.Echo/Watch", watchHandler)
    var port11: int = portOf(srv11.addr())
    var t11: Task<void> = spawn runServer(srv11)

    var client11: GrpcClient = new GrpcClient("127.0.0.1", port11)
    var call11: GrpcClientCall = client11.serverStream("/echo.Echo/Watch", encodeName("go"))
    var first11: Buffer? = call11.recv()
    call11.cancel()
    var rep11: GrpcReply = call11.result()
    test.assertEqual(rep11.status, STATUS_CANCELLED)
    var sig11: bool? = cancelSignal.receive()   // let the handler drain & exit
    client11.close()
    await t11
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 11 client cancel result — " + string(e)) }

// 12 — unary request metadata: server reads custom header sent by client
try {
    var srv12: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv12.register("/echo.Echo/Meta", metaUnaryHandler)
    var port12: int = portOf(srv12.addr())
    var t12: Task<void> = spawn runServer(srv12)

    var client12: GrpcClient = new GrpcClient("127.0.0.1", port12)
    var md12: Metadata = new Metadata()
    md12.set("x-user", "bob")
    var rep12: GrpcReply = client12.unaryMeta("/echo.Echo/Meta", encodeName("x"), md12)
    test.assertEqual(rep12.status, STATUS_OK)
    test.assertEqual(decodeName(rep12.data), "u=bob")
    client12.close()
    await t12
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 12 unary request metadata — " + string(e)) }

// 13 — response metadata: client reads server header + trailer
try {
    var srv13: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv13.registerServerStream("/echo.Echo/MetaStream", metaStreamHandler)
    var port13: int = portOf(srv13.addr())
    var t13: Task<void> = spawn runServer(srv13)

    var client13: GrpcClient = new GrpcClient("127.0.0.1", port13)
    var md13: Metadata = new Metadata()
    md13.set("X-User", "ada")   // mixed case key is lowercased on the wire
    var call13: GrpcClientCall = client13.serverStreamMeta("/echo.Echo/MetaStream", encodeName("x"), md13)
    var first13: Buffer? = call13.recv()
    var body13: string = ""
    if (first13 != null) { body13 = decodeName(first13) }
    var rep13: GrpcReply = call13.result()
    test.assertEqual(body13, "user=ada")
    test.assertEqual(rep13.status, STATUS_OK)
    test.assertEqual(call13.headers().get("x-server"), "v1")
    test.assertEqual(call13.trailers().get("x-trailer"), "done")
    client13.close()
    await t13
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 13 response metadata — " + string(e)) }

// 14 — client gzip request: server decodes a gzip-compressed request body
try {
    var srv14: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv14.register("/echo.Echo/Say", sayHandler)
    var port14: int = portOf(srv14.addr())
    var t14: Task<void> = spawn runServer(srv14)

    var client14: GrpcClient = new GrpcClient("127.0.0.1", port14)
    client14.setCompression("gzip")   // compress outbound request messages
    var rep14: GrpcReply = client14.unary("/echo.Echo/Say", encodeName("world"))
    test.assertEqual(rep14.status, STATUS_OK)
    test.assertEqual(decodeName(rep14.data), "hello, world")
    client14.close()
    await t14
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 14 client gzip request — " + string(e)) }

// 15 — server gzip response: client decodes a gzip-compressed response body
try {
    var srv15: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv15.enableCompression()         // compress responses for gzip-capable clients
    srv15.register("/echo.Echo/Big", bigHandler)
    var port15: int = portOf(srv15.addr())
    var t15: Task<void> = spawn runServer(srv15)

    var client15: GrpcClient = new GrpcClient("127.0.0.1", port15)
    // identity request, but the client always advertises grpc-accept-encoding: gzip
    var rep15: GrpcReply = client15.unary("/echo.Echo/Big", encodeName("x"))
    test.assertEqual(rep15.status, STATUS_OK)
    var s15: string = ""
    var i15: int = 0
    while (i15 < 200) { s15 = s15 + "abcdefghij"; i15 = i15 + 1 }
    test.assertEqual(decodeName(rep15.data), s15)
    client15.close()
    await t15
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 15 server gzip response — " + string(e)) }

// 16 — both directions gzip: compressed request and compressed response
try {
    var srv16: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv16.enableCompression()
    srv16.register("/echo.Echo/Say", sayHandler)
    var port16: int = portOf(srv16.addr())
    var t16: Task<void> = spawn runServer(srv16)

    var client16: GrpcClient = new GrpcClient("127.0.0.1", port16)
    client16.setCompression("gzip")
    var rep16: GrpcReply = client16.unary("/echo.Echo/Say", encodeName("ada"))
    test.assertEqual(rep16.status, STATUS_OK)
    test.assertEqual(decodeName(rep16.data), "hello, ada")
    client16.close()
    await t16
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 16 bidirectional gzip — " + string(e)) }

// 17 — negotiation outcome: server reports req=gzip;resp=gzip when both opt in
try {
    var srv17: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv17.enableCompression()
    srv17.registerServerStream("/echo.Echo/Enc", encReportHandler)
    var port17: int = portOf(srv17.addr())
    var t17: Task<void> = spawn runServer(srv17)

    var client17: GrpcClient = new GrpcClient("127.0.0.1", port17)
    client17.setCompression("gzip")
    var call17: GrpcClientCall = client17.serverStream("/echo.Echo/Enc", encodeName("x"))
    var first17: Buffer? = call17.recv()
    var report17: string = ""
    if (first17 != null) { report17 = decodeName(first17) }
    var rep17: GrpcReply = call17.result()
    test.assertEqual(rep17.status, STATUS_OK)
    test.assertEqual(report17, "req=gzip;resp=gzip")
    client17.close()
    await t17
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 17 negotiation outcome — " + string(e)) }

// 18 — identity negotiation: no opt-in -> req=identity;resp=identity
try {
    var srv18: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv18.registerServerStream("/echo.Echo/Enc", encReportHandler)
    var port18: int = portOf(srv18.addr())
    var t18: Task<void> = spawn runServer(srv18)

    var client18: GrpcClient = new GrpcClient("127.0.0.1", port18)
    var call18: GrpcClientCall = client18.serverStream("/echo.Echo/Enc", encodeName("x"))
    var first18: Buffer? = call18.recv()
    var report18: string = ""
    if (first18 != null) { report18 = decodeName(first18) }
    var rep18: GrpcReply = call18.result()
    test.assertEqual(rep18.status, STATUS_OK)
    test.assertEqual(report18, "req=identity;resp=identity")
    client18.close()
    await t18
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 18 identity negotiation — " + string(e)) }

// 19 — gzip server-streaming: compressed fan-out decoded message-by-message
try {
    var srv19: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv19.enableCompression()
    srv19.registerServerStream("/echo.Echo/Count", countHandler)
    var port19: int = portOf(srv19.addr())
    var t19: Task<void> = spawn runServer(srv19)

    var client19: GrpcClient = new GrpcClient("127.0.0.1", port19)
    client19.setCompression("gzip")
    var call19: GrpcClientCall = client19.serverStream("/echo.Echo/Count", encodeName("x"))
    var acc19: string = ""
    var m19: Buffer? = call19.recv()
    while (m19 != null) {
        acc19 = acc19 + decodeName(m19) + ","
        m19 = call19.recv()
    }
    var rep19: GrpcReply = call19.result()
    test.assertEqual(rep19.status, STATUS_OK)
    test.assertEqual(acc19, "x0,x1,x2,")
    client19.close()
    await t19
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 19 gzip server-stream — " + string(e)) }

// A self-signed cert/key/ca trio valid for localhost + 127.0.0.1 (CN=chuks),
// reused by the TLS/mTLS cases below.
var tlsCerts: any = tlsSelfSigned(["localhost", "127.0.0.1"])

// 20 — TLS unary: gRPC over an encrypted channel (server TLS, client trusts CA)
try {
    var tlsSrvOpts20: any = { "cert": tlsCerts["cert"], "key": tlsCerts["key"] }
    var srv20: GrpcServer = new GrpcServer("127.0.0.1", 0, tlsSrvOpts20)
    srv20.register("/echo.Echo/Say", sayHandler)
    var port20: int = portOf(srv20.addr())
    var t20: Task<void> = spawn runServer(srv20)

    var client20: GrpcClient = new GrpcClient("127.0.0.1", port20, { "ca": tlsCerts["ca"] })
    var rep20: GrpcReply = client20.unary("/echo.Echo/Say", encodeName("tls"))
    test.assertEqual(rep20.status, STATUS_OK)
    test.assertEqual(decodeName(rep20.data), "hello, tls")
    client20.close()
    await t20
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 20 TLS unary — " + string(e)) }

// 21 — mTLS: client presents a cert; server verifies it and reads its CN
try {
    var mtlsSrvOpts21: any = { "cert": tlsCerts["cert"], "key": tlsCerts["key"], "clientCA": tlsCerts["ca"], "requireClientCert": true }
    var srv21: GrpcServer = new GrpcServer("127.0.0.1", 0, mtlsSrvOpts21)
    srv21.register("/echo.Echo/Peer", peerHandler)
    var port21: int = portOf(srv21.addr())
    var t21: Task<void> = spawn runServer(srv21)

    var mtlsCliOpts21: any = { "ca": tlsCerts["ca"], "cert": tlsCerts["cert"], "key": tlsCerts["key"] }
    var client21: GrpcClient = new GrpcClient("127.0.0.1", port21, mtlsCliOpts21)
    var rep21: GrpcReply = client21.unary("/echo.Echo/Peer", encodeName("x"))
    test.assertEqual(rep21.status, STATUS_OK)
    test.assertEqual(decodeName(rep21.data), "cn=chuks")
    client21.close()
    await t21
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 21 mTLS peer CN — " + string(e)) }

// 22 — mTLS rejection: server requires a client cert; a client without one fails
try {
    var rejSrvOpts22: any = { "cert": tlsCerts["cert"], "key": tlsCerts["key"], "clientCA": tlsCerts["ca"], "requireClientCert": true }
    var srv22: GrpcServer = new GrpcServer("127.0.0.1", 0, rejSrvOpts22)
    srv22.register("/echo.Echo/Say", sayHandler)
    var port22: int = portOf(srv22.addr())
    var t22: Task<void> = spawn runServer(srv22)

    var rejected22: bool = false
    try {
        // No client cert: the TLS handshake must fail. Depending on timing this
        // surfaces either as a connect/handshake exception or as a non-OK reply
        // once the broken transport is observed — both count as a rejection.
        var client22: GrpcClient = new GrpcClient("127.0.0.1", port22, { "ca": tlsCerts["ca"] })
        var rep22: GrpcReply = client22.unary("/echo.Echo/Say", encodeName("x"))
        if (rep22.status != STATUS_OK) { rejected22 = true }
        client22.close()
    } catch (inner22) {
        rejected22 = true
    }
    test.assertEqual(rejected22, true)
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 22 mTLS rejection — " + string(e)) }

// 23 — server unary interceptors run outermost-first around the handler
try {
    var srv23: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv23.register("/echo.Echo/Say", sayHandler)
    srv23.useUnaryInterceptor(wrapA)
    srv23.useUnaryInterceptor(wrapB)
    var port23: int = portOf(srv23.addr())
    var t23: Task<void> = spawn runServer(srv23)

    var client23: GrpcClient = new GrpcClient("127.0.0.1", port23)
    var rep23: GrpcReply = client23.unary("/echo.Echo/Say", encodeName("world"))
    test.assertEqual(rep23.status, STATUS_OK)
    test.assertEqual(decodeName(rep23.data), "A(B(hello, world))")
    client23.close()
    await t23
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 23 server unary interceptor order — " + string(e)) }

// 24 — server unary interceptor short-circuits (auth deny, handler never runs)
try {
    var srv24: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv24.register("/echo.Echo/Say", sayHandler)
    srv24.useUnaryInterceptor(denyAuth)
    var port24: int = portOf(srv24.addr())
    var t24: Task<void> = spawn runServer(srv24)

    var client24: GrpcClient = new GrpcClient("127.0.0.1", port24)
    var rep24: GrpcReply = client24.unary("/echo.Echo/Say", encodeName("world"))
    test.assertEqual(rep24.status, STATUS_UNAUTHENTICATED)
    test.assertEqual(rep24.message, "no token")
    client24.close()
    await t24
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 24 server interceptor short-circuit — " + string(e)) }

// 25 — client unary interceptor rewrites the outbound request message
try {
    var srv25: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv25.register("/echo.Echo/Say", sayHandler)
    var port25: int = portOf(srv25.addr())
    var t25: Task<void> = spawn runServer(srv25)

    var client25: GrpcClient = new GrpcClient("127.0.0.1", port25)
    client25.useUnaryInterceptor(bangRequest)
    var rep25: GrpcReply = client25.unary("/echo.Echo/Say", encodeName("world"))
    test.assertEqual(rep25.status, STATUS_OK)
    test.assertEqual(decodeName(rep25.data), "hello, world!")
    client25.close()
    await t25
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 25 client interceptor rewrites request — " + string(e)) }

// 26 — client unary interceptor post-processes the reply
try {
    var srv26: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv26.register("/echo.Echo/Say", sayHandler)
    var port26: int = portOf(srv26.addr())
    var t26: Task<void> = spawn runServer(srv26)

    var client26: GrpcClient = new GrpcClient("127.0.0.1", port26)
    client26.useUnaryInterceptor(wrapReply)
    var rep26: GrpcReply = client26.unary("/echo.Echo/Say", encodeName("world"))
    test.assertEqual(rep26.status, STATUS_OK)
    test.assertEqual(decodeName(rep26.data), "wrapped:hello, world")
    client26.close()
    await t26
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 26 client interceptor post-processes reply — " + string(e)) }

// 27 — server stream interceptor wraps a server-streaming handler
try {
    var srv27: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv27.registerServerStream("/echo.Echo/Count", countHandler)
    srv27.useStreamInterceptor(tagStream)
    var port27: int = portOf(srv27.addr())
    var t27: Task<void> = spawn runServer(srv27)

    var client27: GrpcClient = new GrpcClient("127.0.0.1", port27)
    var call27: GrpcClientCall = client27.serverStream("/echo.Echo/Count", encodeName("n"))
    var got27: int = 0
    var m27: Buffer? = call27.recv()
    while (m27 != null) {
        got27 = got27 + 1
        m27 = call27.recv()
    }
    var rep27: GrpcReply = call27.result()
    test.assertEqual(rep27.status, STATUS_OK)
    test.assertEqual(got27, 3)
    test.assertEqual(call27.headers().get("x-intercepted"), "yes")
    client27.close()
    await t27
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 27 server stream interceptor — " + string(e)) }

// 28 — keepalive: client pings an idle connection and receives ACKs
try {
    var srv28: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv28.register("/echo.Echo/Say", sayHandler)
    var port28: int = portOf(srv28.addr())
    var t28: Task<void> = spawn runServer(srv28)

    var client28: GrpcClient = new GrpcClient("127.0.0.1", port28)
    // Warm the connection, then idle while keepalive pings fly.
    var pre28: GrpcReply = client28.unary("/echo.Echo/Say", encodeName("ping"))
    test.assertEqual(pre28.status, STATUS_OK)
    client28.enableKeepalive(50, 1000)
    time.sleep(220)
    test.assert(client28.keepaliveAcks() >= 1)
    // Connection is still healthy for real RPCs after keepalive activity.
    var post28: GrpcReply = client28.unary("/echo.Echo/Say", encodeName("again"))
    test.assertEqual(post28.status, STATUS_OK)
    test.assertEqual(decodeName(post28.data), "hello, again")
    client28.close()
    await t28
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 28 keepalive liveness — " + string(e)) }

// 29 — retry recovers: handler fails twice (UNAVAILABLE) then succeeds
try {
    flaky29 = 0
    var srv29: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv29.register("/echo.Echo/Flaky", flakyHandler)
    var port29: int = portOf(srv29.addr())
    var t29: Task<void> = spawn runServer(srv29)

    var client29: GrpcClient = new GrpcClient("127.0.0.1", port29)
    var pol29: RetryPolicy = { maxAttempts: 5, initialBackoffMs: 5, maxBackoffMs: 50, backoffMultiplier: 2, retryableStatuses: [STATUS_UNAVAILABLE] }
    client29.setRetryPolicy(pol29)
    var rep29: GrpcReply = client29.unary("/echo.Echo/Flaky", encodeName("x"))
    test.assertEqual(rep29.status, STATUS_OK)
    test.assertEqual(decodeName(rep29.data), "recovered")
    test.assertEqual(flaky29, 3)
    client29.close()
    await t29
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 29 retry recovers — " + string(e)) }

// 30 — non-retryable status is not retried (handler runs exactly once)
try {
    flaky30 = 0
    var srv30: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv30.register("/echo.Echo/Bad", badArgHandler)
    var port30: int = portOf(srv30.addr())
    var t30: Task<void> = spawn runServer(srv30)

    var client30: GrpcClient = new GrpcClient("127.0.0.1", port30)
    client30.setRetryPolicy(defaultRetryPolicy())
    var rep30: GrpcReply = client30.unary("/echo.Echo/Bad", encodeName("x"))
    test.assertEqual(rep30.status, STATUS_INVALID_ARGUMENT)
    test.assertEqual(flaky30, 1)
    client30.close()
    await t30
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 30 non-retryable not retried — " + string(e)) }

// 31 — retries exhausted: returns the last (retryable) error after maxAttempts
try {
    flaky31 = 0
    var srv31: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv31.register("/echo.Echo/Down", alwaysDownHandler)
    var port31: int = portOf(srv31.addr())
    var t31: Task<void> = spawn runServer(srv31)

    var client31: GrpcClient = new GrpcClient("127.0.0.1", port31)
    var pol31: RetryPolicy = { maxAttempts: 3, initialBackoffMs: 5, maxBackoffMs: 50, backoffMultiplier: 2, retryableStatuses: [STATUS_UNAVAILABLE] }
    client31.setRetryPolicy(pol31)
    var rep31: GrpcReply = client31.unary("/echo.Echo/Down", encodeName("x"))
    test.assertEqual(rep31.status, STATUS_UNAVAILABLE)
    test.assertEqual(flaky31, 3)
    client31.close()
    await t31
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 31 retries exhausted — " + string(e)) }

// 32 — retries are disabled by default (a retryable failure runs once)
try {
    flaky31 = 0
    var srv32: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv32.register("/echo.Echo/Down", alwaysDownHandler)
    var port32: int = portOf(srv32.addr())
    var t32: Task<void> = spawn runServer(srv32)

    var client32: GrpcClient = new GrpcClient("127.0.0.1", port32)
    var rep32: GrpcReply = client32.unary("/echo.Echo/Down", encodeName("x"))
    test.assertEqual(rep32.status, STATUS_UNAVAILABLE)
    test.assertEqual(flaky31, 1)
    client32.close()
    await t32
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 32 retries disabled by default — " + string(e)) }

// ── Load-balancing & health fixtures (M14/M15) ──────────────────────────────
// Identity handlers so a load-balanced client can tell which backend served it.
function id0Handler(req: GrpcRequest): GrpcResponse { return grpcOk(encodeName("id=0")) }
function id1Handler(req: GrpcRequest): GrpcResponse { return grpcOk(encodeName("id=1")) }
function id2Handler(req: GrpcRequest): GrpcResponse { return grpcOk(encodeName("id=2")) }

// 33 — static name resolution parses "host:port" lists (with stray whitespace)
try {
    var eps33: []Endpoint = resolveStatic("127.0.0.1:1000, 127.0.0.1:2000 ,localhost:3000")
    test.assertEqual(eps33.length, 3)
    test.assertEqual(eps33[0].host, "127.0.0.1")
    test.assertEqual(eps33[0].port, 1000)
    test.assertEqual(eps33[1].port, 2000)
    test.assertEqual(eps33[2].host, "localhost")
    test.assertEqual(eps33[2].port, 3000)
    // Entries without a port are dropped.
    var eps33b: []Endpoint = resolveStatic("127.0.0.1,127.0.0.1:7")
    test.assertEqual(eps33b.length, 1)
    test.assertEqual(eps33b[0].port, 7)
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 33 resolveStatic — " + string(e)) }

// 34 — round-robin spreads calls evenly across three backends
try {
    var srvA34: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srvA34.register("/lb.Echo/Id", id0Handler)
    var pA34: int = portOf(srvA34.addr())
    var tA34: Task<void> = spawn runServer(srvA34)

    var srvB34: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srvB34.register("/lb.Echo/Id", id1Handler)
    var pB34: int = portOf(srvB34.addr())
    var tB34: Task<void> = spawn runServer(srvB34)

    var srvC34: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srvC34.register("/lb.Echo/Id", id2Handler)
    var pC34: int = portOf(srvC34.addr())
    var tC34: Task<void> = spawn runServer(srvC34)

    var target34: string = "127.0.0.1:" + string(pA34) + ",127.0.0.1:" + string(pB34) + ",127.0.0.1:" + string(pC34)
    var ch34: GrpcChannel = new GrpcChannel(target34, LB_ROUND_ROBIN)
    test.assertEqual(ch34.subchannelCount(), 3)
    test.assertEqual(ch34.readyCount(), 3)

    var seq34: string = ""
    var k34: int = 0
    while (k34 < 6) {
        var r34: GrpcReply = ch34.unary("/lb.Echo/Id", encodeName("x"))
        test.assertEqual(r34.status, STATUS_OK)
        seq34 = seq34 + decodeName(r34.data) + ";"
        k34 = k34 + 1
    }
    test.assertEqual(seq34, "id=0;id=1;id=2;id=0;id=1;id=2;")
    ch34.close()
    await tA34
    await tB34
    await tC34
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 34 round-robin — " + string(e)) }

// 35 — pick-first routes every call to the first reachable backend
try {
    var srvA35: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srvA35.register("/lb.Echo/Id", id0Handler)
    var pA35: int = portOf(srvA35.addr())
    var tA35: Task<void> = spawn runServer(srvA35)

    var srvB35: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srvB35.register("/lb.Echo/Id", id1Handler)
    var pB35: int = portOf(srvB35.addr())
    var tB35: Task<void> = spawn runServer(srvB35)

    var target35: string = "127.0.0.1:" + string(pA35) + ",127.0.0.1:" + string(pB35)
    var ch35: GrpcChannel = new GrpcChannel(target35, LB_PICK_FIRST)

    var seq35: string = ""
    var k35: int = 0
    while (k35 < 4) {
        var r35: GrpcReply = ch35.unary("/lb.Echo/Id", encodeName("x"))
        seq35 = seq35 + decodeName(r35.data) + ";"
        k35 = k35 + 1
    }
    test.assertEqual(seq35, "id=0;id=0;id=0;id=0;")
    ch35.close()
    await tA35
    await tB35
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 35 pick-first — " + string(e)) }

// 36 — health Check reports SERVING for a registered service
try {
    var srv36: GrpcServer = new GrpcServer("127.0.0.1", 0)
    var health36: HealthService = new HealthService()
    health36.setServing("pkg.Svc")
    registerHealthService(srv36, health36)
    var port36: int = portOf(srv36.addr())
    var t36: Task<void> = spawn runServer(srv36)

    var client36: GrpcClient = new GrpcClient("127.0.0.1", port36)
    var hc36: HealthClient = new HealthClient(client36)
    test.assertEqual(hc36.check("pkg.Svc"), SERVING_SERVING)
    test.assertEqual(hc36.check(""), SERVING_SERVING)          // overall server defaults SERVING
    test.assertEqual(hc36.check("nope.Svc"), SERVING_SERVICE_UNKNOWN)
    test.assert(hc36.isServing("pkg.Svc"))
    client36.close()
    await t36
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 36 health serving — " + string(e)) }

// 37 — health Check reports NOT_SERVING after the service is taken down
try {
    var srv37: GrpcServer = new GrpcServer("127.0.0.1", 0)
    var health37: HealthService = new HealthService()
    health37.setNotServing("pkg.Svc")
    registerHealthService(srv37, health37)
    var port37: int = portOf(srv37.addr())
    var t37: Task<void> = spawn runServer(srv37)

    var client37: GrpcClient = new GrpcClient("127.0.0.1", port37)
    var hc37: HealthClient = new HealthClient(client37)
    test.assertEqual(hc37.check("pkg.Svc"), SERVING_NOT_SERVING)
    test.assert(!hc37.isServing("pkg.Svc"))
    client37.close()
    await t37
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 37 health not serving — " + string(e)) }

// 38 — health-aware load balancing: refreshHealth drops a NOT_SERVING backend
try {
    var srvA38: GrpcServer = new GrpcServer("127.0.0.1", 0)
    var hA38: HealthService = new HealthService()
    hA38.setServing("svc")
    srvA38.register("/lb.Echo/Id", id0Handler)
    registerHealthService(srvA38, hA38)
    var pA38: int = portOf(srvA38.addr())
    var tA38: Task<void> = spawn runServer(srvA38)

    var srvB38: GrpcServer = new GrpcServer("127.0.0.1", 0)
    var hB38: HealthService = new HealthService()
    hB38.setNotServing("svc")
    srvB38.register("/lb.Echo/Id", id1Handler)
    registerHealthService(srvB38, hB38)
    var pB38: int = portOf(srvB38.addr())
    var tB38: Task<void> = spawn runServer(srvB38)

    var srvC38: GrpcServer = new GrpcServer("127.0.0.1", 0)
    var hC38: HealthService = new HealthService()
    hC38.setServing("svc")
    srvC38.register("/lb.Echo/Id", id2Handler)
    registerHealthService(srvC38, hC38)
    var pC38: int = portOf(srvC38.addr())
    var tC38: Task<void> = spawn runServer(srvC38)

    var target38: string = "127.0.0.1:" + string(pA38) + ",127.0.0.1:" + string(pB38) + ",127.0.0.1:" + string(pC38)
    var ch38: GrpcChannel = new GrpcChannel(target38, LB_ROUND_ROBIN)
    test.assertEqual(ch38.readyCount(), 3)
    ch38.refreshHealth("svc")
    test.assertEqual(ch38.readyCount(), 2)        // middle backend dropped

    var seq38: string = ""
    var k38: int = 0
    while (k38 < 4) {
        var r38: GrpcReply = ch38.unary("/lb.Echo/Id", encodeName("x"))
        seq38 = seq38 + decodeName(r38.data) + ";"
        k38 = k38 + 1
    }
    test.assertEqual(seq38, "id=0;id=2;id=0;id=2;")   // backend 1 never serves
    ch38.close()
    await tA38
    await tB38
    await tC38
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 38 health-aware LB — " + string(e)) }

// 39 — a dead endpoint is skipped; the channel still serves from live ones
try {
    var dead39: GrpcServer = new GrpcServer("127.0.0.1", 0)
    var deadPort39: int = portOf(dead39.addr())
    dead39.close()

    var live39: GrpcServer = new GrpcServer("127.0.0.1", 0)
    live39.register("/lb.Echo/Id", id0Handler)
    var livePort39: int = portOf(live39.addr())
    var t39: Task<void> = spawn runServer(live39)

    var target39: string = "127.0.0.1:" + string(deadPort39) + ",127.0.0.1:" + string(livePort39)
    var ch39: GrpcChannel = new GrpcChannel(target39, LB_ROUND_ROBIN)
    test.assertEqual(ch39.endpointCount(), 2)
    test.assertEqual(ch39.subchannelCount(), 1)     // dead endpoint excluded

    var r39: GrpcReply = ch39.unary("/lb.Echo/Id", encodeName("x"))
    test.assertEqual(r39.status, STATUS_OK)
    test.assertEqual(decodeName(r39.data), "id=0")
    ch39.close()
    await t39
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 39 dead endpoint skipped — " + string(e)) }

// ── Server reflection fixtures (M16) ────────────────────────────────────────
function reflSayHandler(req: GrpcRequest): GrpcResponse { return grpcOk(encodeName("hi")) }
function reflCountHandler(req: GrpcRequest, stream: GrpcServerStream): void { stream.send(encodeName("1")) }

// 40 — reflection list_services advertises every registered service plus itself
try {
    var srv40: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv40.register("/echo.Echo/Say", reflSayHandler)
    srv40.registerServerStream("/echo.Echo/Count", reflCountHandler)
    srv40.register("/calc.Math/Add", reflSayHandler)
    var refl40: ReflectionService = new ReflectionService()
    refl40.addServerServices(srv40)
    registerReflectionService(srv40, refl40)
    var port40: int = portOf(srv40.addr())
    var t40: Task<void> = spawn runServer(srv40)

    var client40: GrpcClient = new GrpcClient("127.0.0.1", port40)
    var rc40: ReflectionClient = new ReflectionClient(client40)
    var svcs40: []string = rc40.listServices()
    // echo.Echo, calc.Math, the reflection service, plus the registered
    // reflection method's own path-derived name — assert membership, not order.
    var hasEcho40: bool = false
    var hasMath40: bool = false
    var hasRefl40: bool = false
    var i40: int = 0
    while (i40 < svcs40.length) {
        if (svcs40[i40] == "echo.Echo") { hasEcho40 = true }
        if (svcs40[i40] == "calc.Math") { hasMath40 = true }
        if (svcs40[i40] == "grpc.reflection.v1alpha.ServerReflection") { hasRefl40 = true }
        i40 = i40 + 1
    }
    test.assert(hasEcho40)
    test.assert(hasMath40)
    test.assert(hasRefl40)
    client40.close()
    await t40
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 40 reflection list_services — " + string(e)) }

// 41 — GrpcServer.serviceNames derives distinct names from method paths
try {
    var srv41: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv41.register("/echo.Echo/Say", reflSayHandler)
    srv41.register("/echo.Echo/Shout", reflSayHandler)   // same service, second method
    srv41.register("/calc.Math/Add", reflSayHandler)
    var names41: []string = srv41.serviceNames()
    // Two distinct services despite three methods (echo.Echo collapses).
    test.assertEqual(names41.length, 2)
    var hasEcho41: bool = false
    var hasMath41: bool = false
    var i41: int = 0
    while (i41 < names41.length) {
        if (names41[i41] == "echo.Echo") { hasEcho41 = true }
        if (names41[i41] == "calc.Math") { hasMath41 = true }
        i41 = i41 + 1
    }
    test.assert(hasEcho41)
    test.assert(hasMath41)
    srv41.close()
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 41 serviceNames distinct — " + string(e)) }

// 42 — an unsupported reflection query yields an honest UNIMPLEMENTED error
try {
    var srv42: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv42.register("/echo.Echo/Say", reflSayHandler)
    var refl42: ReflectionService = new ReflectionService()
    refl42.addServerServices(srv42)
    registerReflectionService(srv42, refl42)
    var port42: int = portOf(srv42.addr())
    var t42: Task<void> = spawn runServer(srv42)

    var client42: GrpcClient = new GrpcClient("127.0.0.1", port42)
    // Hand-craft a file_containing_symbol request (field 4) — not supported.
    var rq42: ProtoWriter = new ProtoWriter()
    rq42.writeString(4, "echo.Echo")
    var call42: GrpcClientCall = client42.bidiStream("/grpc.reflection.v1alpha.ServerReflection/ServerReflectionInfo")
    call42.send(rq42.toBuffer())
    call42.closeSend()
    var resp42: Buffer? = call42.recv()
    test.assert(resp42 != null)
    // Decode the ServerReflectionResponse: expect an ErrorResponse (field 7)
    // carrying error_code (field 1) == UNIMPLEMENTED.
    var code42: int = -1
    if (resp42 != null) {
        var rr42: ProtoReader = new ProtoReader(resp42)
        while (rr42.hasMore()) {
            var tg42: ProtoTag = rr42.readTag()
            if (tg42.field == 7 && tg42.wireType == PB_LEN) {
                var er42: ProtoReader = rr42.readMessage()
                while (er42.hasMore()) {
                    var et42: ProtoTag = er42.readTag()
                    if (et42.field == 1) {
                        code42 = er42.readVarint()
                    } else {
                        er42.skip(et42.wireType)
                    }
                }
            } else {
                rr42.skip(tg42.wireType)
            }
        }
    }
    test.assertEqual(code42, STATUS_UNIMPLEMENTED)
    var drain42: Buffer? = call42.recv()
    while (drain42 != null) {
        drain42 = call42.recv()
    }
    call42.result()
    client42.close()
    await t42
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 42 reflection unsupported query — " + string(e)) }

// ── Stats / tracing hooks (M17) ─────────────────────────────────────────────

// Unary handler that always fails, to verify the failing status reaches stats.
function statsFailHandler(req: GrpcRequest): GrpcResponse {
    return grpcError(STATUS_INVALID_ARGUMENT, "nope")
}

// ── Rich error model (M18) ──────────────────────────────────────────────────

// Unary handler that fails with a single structured error detail.
function detailHandler(req: GrpcRequest): GrpcResponse {
    var info = new ProtoWriter()
    info.writeString(1, "OUT_OF_RANGE")
    var det: []ErrorDetail = [mkErrorDetail("type.googleapis.com/google.rpc.ErrorInfo", info.toBuffer())]
    return grpcErrorWithDetails(STATUS_INVALID_ARGUMENT, "bad input", det)
}

// Unary handler that fails with two structured error details.
function multiDetailHandler(req: GrpcRequest): GrpcResponse {
    var a = new ProtoWriter()
    a.writeString(1, "reason-a")
    var b = new ProtoWriter()
    b.writeString(1, "reason-b")
    var det: []ErrorDetail = [
        mkErrorDetail("type.googleapis.com/google.rpc.BadRequest", a.toBuffer()),
        mkErrorDetail("type.googleapis.com/google.rpc.RetryInfo", b.toBuffer())
    ]
    return grpcErrorWithDetails(STATUS_UNAVAILABLE, "two details", det)
}

// 43 — a server stats handler observes every completed unary RPC
try {
    var srv43: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv43.register("/echo.Echo/Say", sayHandler)
    var statsCh43: Channel<RpcStats> = new Channel<RpcStats>(4)
    srv43.useStatsHandler(function(s: RpcStats): void {
        statsCh43.send(s)
    })
    var port43: int = portOf(srv43.addr())
    var t43: Task<void> = spawn runServer(srv43)

    var client43: GrpcClient = new GrpcClient("127.0.0.1", port43)
    var rep43: GrpcReply = client43.unary("/echo.Echo/Say", encodeName("stats"))
    test.assertEqual(rep43.status, STATUS_OK)

    var got43: RpcStats? = statsCh43.receive()
    test.assert(got43 != null)
    if (got43 != null) {
        test.assertEqual(got43.method, "/echo.Echo/Say")
        test.assertEqual(got43.status, STATUS_OK)
        test.assert(!got43.isClient)
        test.assert(got43.durationMs >= 0)
        test.assert(got43.endMs >= got43.startMs)
    }
    client43.close()
    await t43
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 43 server unary stats — " + string(e)) }

// 44 — server stats reports the handler's non-OK status
try {
    var srv44: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv44.register("/echo.Echo/Fail", statsFailHandler)
    var statsCh44: Channel<RpcStats> = new Channel<RpcStats>(4)
    srv44.useStatsHandler(function(s: RpcStats): void {
        statsCh44.send(s)
    })
    var port44: int = portOf(srv44.addr())
    var t44: Task<void> = spawn runServer(srv44)

    var client44: GrpcClient = new GrpcClient("127.0.0.1", port44)
    var rep44: GrpcReply = client44.unary("/echo.Echo/Fail", encodeName("x"))
    test.assertEqual(rep44.status, STATUS_INVALID_ARGUMENT)

    var got44: RpcStats? = statsCh44.receive()
    test.assert(got44 != null)
    if (got44 != null) {
        test.assertEqual(got44.method, "/echo.Echo/Fail")
        test.assertEqual(got44.status, STATUS_INVALID_ARGUMENT)
        test.assert(!got44.isClient)
    }
    client44.close()
    await t44
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 44 server error stats — " + string(e)) }

// 45 — a client stats handler observes the outgoing unary call
try {
    var srv45: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv45.register("/echo.Echo/Say", sayHandler)
    var port45: int = portOf(srv45.addr())
    var t45: Task<void> = spawn runServer(srv45)

    var client45: GrpcClient = new GrpcClient("127.0.0.1", port45)
    var statsCh45: Channel<RpcStats> = new Channel<RpcStats>(4)
    client45.useStatsHandler(function(s: RpcStats): void {
        statsCh45.send(s)
    })
    var rep45: GrpcReply = client45.unary("/echo.Echo/Say", encodeName("hi"))
    test.assertEqual(rep45.status, STATUS_OK)

    var got45: RpcStats? = statsCh45.receive()
    test.assert(got45 != null)
    if (got45 != null) {
        test.assertEqual(got45.method, "/echo.Echo/Say")
        test.assertEqual(got45.status, STATUS_OK)
        test.assert(got45.isClient)
        test.assert(got45.durationMs >= 0)
    }
    client45.close()
    await t45
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 45 client unary stats — " + string(e)) }

// 46 — server stats fire for streaming RPCs too (status via finishStatus)
try {
    var srv46: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv46.registerServerStream("/echo.Echo/Count", countHandler)
    var statsCh46: Channel<RpcStats> = new Channel<RpcStats>(4)
    srv46.useStatsHandler(function(s: RpcStats): void {
        statsCh46.send(s)
    })
    var port46: int = portOf(srv46.addr())
    var t46: Task<void> = spawn runServer(srv46)

    var client46: GrpcClient = new GrpcClient("127.0.0.1", port46)
    var call46: GrpcClientCall = client46.serverStream("/echo.Echo/Count", encodeName("n"))
    var msg46: Buffer? = call46.recv()
    while (msg46 != null) {
        msg46 = call46.recv()
    }
    call46.result()

    var got46: RpcStats? = statsCh46.receive()
    test.assert(got46 != null)
    if (got46 != null) {
        test.assertEqual(got46.method, "/echo.Echo/Count")
        test.assertEqual(got46.status, STATUS_OK)
        test.assert(!got46.isClient)
    }
    client46.close()
    await t46
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 46 server stream stats — " + string(e)) }

// ── Rich error model (M18) ──────────────────────────────────────────────────

// 47 — a server error with a single rich detail is decoded back by the client
try {
    var srv47: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv47.register("/echo.Echo/Fail", detailHandler)
    var port47: int = portOf(srv47.addr())
    var t47: Task<void> = spawn runServer(srv47)

    var client47: GrpcClient = new GrpcClient("127.0.0.1", port47)
    var rep47: GrpcReply = client47.unary("/echo.Echo/Fail", encodeName("x"))
    test.assertEqual(rep47.status, STATUS_INVALID_ARGUMENT)
    test.assertEqual(rep47.message, "bad input")
    test.assertEqual(rep47.details.length, 1)
    if (rep47.details.length == 1) {
        test.assertEqual(rep47.details[0].typeUrl, "type.googleapis.com/google.rpc.ErrorInfo")
        var dr47: ProtoReader = new ProtoReader(rep47.details[0].value)
        var tg47: ProtoTag = dr47.readTag()
        test.assertEqual(tg47.field, 1)
        test.assertEqual(dr47.readString(), "OUT_OF_RANGE")
    }
    client47.close()
    await t47
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 47 rich error single detail — " + string(e)) }

// 48 — a successful reply carries no details
try {
    var srv48: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv48.register("/echo.Echo/Say", sayHandler)
    var port48: int = portOf(srv48.addr())
    var t48: Task<void> = spawn runServer(srv48)

    var client48: GrpcClient = new GrpcClient("127.0.0.1", port48)
    var rep48: GrpcReply = client48.unary("/echo.Echo/Say", encodeName("hi"))
    test.assertEqual(rep48.status, STATUS_OK)
    test.assertEqual(rep48.details.length, 0)
    client48.close()
    await t48
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 48 success has no details — " + string(e)) }

// 49 — multiple details round-trip in order
try {
    var srv49: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv49.register("/echo.Echo/Multi", multiDetailHandler)
    var port49: int = portOf(srv49.addr())
    var t49: Task<void> = spawn runServer(srv49)

    var client49: GrpcClient = new GrpcClient("127.0.0.1", port49)
    var rep49: GrpcReply = client49.unary("/echo.Echo/Multi", encodeName("y"))
    test.assertEqual(rep49.status, STATUS_UNAVAILABLE)
    test.assertEqual(rep49.details.length, 2)
    if (rep49.details.length == 2) {
        test.assertEqual(rep49.details[0].typeUrl, "type.googleapis.com/google.rpc.BadRequest")
        test.assertEqual(rep49.details[1].typeUrl, "type.googleapis.com/google.rpc.RetryInfo")
        var dr49: ProtoReader = new ProtoReader(rep49.details[1].value)
        var tg49: ProtoTag = dr49.readTag()
        test.assertEqual(tg49.field, 1)
        test.assertEqual(dr49.readString(), "reason-b")
    }
    client49.close()
    await t49
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 49 multiple details round-trip — " + string(e)) }

print("═══════════════════════════════════════")
print("  gRPC h2c round-trip test results")
print("  Passed: " + string(passed))
print("  Failed: " + string(failed))
print("  Total:  " + string(passed + failed))
print("═══════════════════════════════════════")
