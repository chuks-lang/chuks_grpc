// ─── chuks_grpc · end-to-end gRPC (h2c) round-trip tests ───────────────────
// Spins up a real in-process gRPC server on an ephemeral port and drives it
// with the gRPC client over a live TCP/HTTP-2 connection.

import { test } from "std/test"
import { Buffer } from "std/buffer"
import { time } from "std/time"
import { Channel } from "std/channel"
import {
    GrpcServer, GrpcClient, GrpcRequest, GrpcResponse, GrpcReply,
    GrpcServerStream, GrpcClientCall,
    Metadata, metadataFromHeaders,
    grpcOk,
    STATUS_OK, STATUS_UNIMPLEMENTED, STATUS_DEADLINE_EXCEEDED, STATUS_CANCELLED
} from "../src/index.chuks"
import { ProtoWriter, ProtoReader, ProtoTag, PB_LEN } from "../src/protobuf.chuks"

var passed: any = 0
var failed: any = 0

// Parse the port out of a "host:port" address string.
function portOf(addr: string): int {
    var b: Buffer = Buffer.fromString(addr)
    var n: int = b.length()
    var colon: int = -1
    var i: int = 0
    while (i < n) {
        if (b.getByte(i) == 58) { colon = i }   // ':'
        i = i + 1
    }
    var val: int = 0
    var j: int = colon + 1
    while (j < n) {
        var c: int = b.getByte(j)
        if (c >= 48 && c <= 57) { val = val * 10 + (c - 48) }
        j = j + 1
    }
    return val
}

// Encode a protobuf message { field 1: string }.
function encodeName(name: string): Buffer {
    var w: ProtoWriter = new ProtoWriter()
    w.writeString(1, name)
    return w.toBuffer()
}

// Decode field 1 (string) from a protobuf message.
function decodeName(data: Buffer): string {
    var r: ProtoReader = new ProtoReader(data)
    var out: string = ""
    while (r.hasMore()) {
        var tag: ProtoTag = r.readTag()
        if (tag.field == 1 && tag.wireType == PB_LEN) {
            out = r.readString()
        } else {
            r.skip(tag.wireType)
        }
    }
    return out
}

// Handler: Echo.Say(name) -> "hello, " + name
function sayHandler(req: GrpcRequest): GrpcResponse {
    var name: string = decodeName(req.data)
    return grpcOk(encodeName("hello, " + name))
}

// Server-streaming handler: one request "name" -> three messages name0/1/2.
function countHandler(req: GrpcRequest, stream: GrpcServerStream): void {
    var name: string = decodeName(req.data)
    var i: int = 0
    while (i < 3) {
        stream.send(encodeName(name + string(i)))
        i = i + 1
    }
}

// Client-streaming handler: drain all requests -> one reply "count=N".
function collectHandler(stream: GrpcServerStream): GrpcResponse {
    var count: int = 0
    var m: Buffer? = stream.recv()
    while (m != null) {
        count = count + 1
        m = stream.recv()
    }
    return grpcOk(encodeName("count=" + string(count)))
}

// Bidirectional handler: echo each request back as "echo:<name>".
function chatHandler(stream: GrpcServerStream): void {
    var m: Buffer? = stream.recv()
    while (m != null) {
        stream.send(encodeName("echo:" + decodeName(m)))
        m = stream.recv()
    }
}

// Slow unary handler: sleeps past a short client deadline before replying.
function slowHandler(req: GrpcRequest): GrpcResponse {
    time.sleep(300)
    return grpcOk(encodeName("late"))
}

// Reports whether the server observed a client deadline on the request.
function deadlineEchoHandler(req: GrpcRequest): GrpcResponse {
    if (req.deadlineMs > 0) {
        return grpcOk(encodeName("has-deadline"))
    }
    return grpcOk(encodeName("no-deadline"))
}

// Signals out of the cancel-watch handler whether it observed cancellation.
var cancelSignal: Channel<bool> = new Channel<bool>(1)

// Server-streaming handler that emits "started", then polls for cancellation
// and reports (true once the client cancels, false if it times out waiting).
function watchHandler(req: GrpcRequest, stream: GrpcServerStream): void {
    stream.send(encodeName("started"))
    var i: int = 0
    while (i < 2000) {
        if (stream.cancelled()) {
            cancelSignal.send(true)
            return
        }
        time.sleep(2)
        i = i + 1
    }
    cancelSignal.send(false)
}

// Unary handler: reads request metadata "x-user" and echoes it back.
function metaUnaryHandler(req: GrpcRequest): GrpcResponse {
    var user: string = metadataFromHeaders(req.metadata).get("x-user")
    return grpcOk(encodeName("u=" + user))
}

// Server-streaming handler: reads request metadata, sets a custom response
// header and trailer, and echoes the caller's "x-user" value once.
function metaStreamHandler(req: GrpcRequest, stream: GrpcServerStream): void {
    var user: string = stream.requestMetadata().get("x-user")
    stream.setHeader("x-server", "v1")
    stream.send(encodeName("user=" + user))
    stream.setTrailer("x-trailer", "done")
}

// Run a single connection's worth of serving on a background task.
async function runServer(srv: GrpcServer): Task<void> {
    srv.serveOnce()
}

// 1 — unary round-trip echo
try {
    var srv: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv.register("/echo.Echo/Say", sayHandler)
    var port: int = portOf(srv.addr())
    var t: Task<void> = spawn runServer(srv)

    var client: GrpcClient = new GrpcClient("127.0.0.1", port)
    var reply: GrpcReply = client.unary("/echo.Echo/Say", encodeName("world"))
    test.assertEqual(reply.status, STATUS_OK)
    test.assertEqual(decodeName(reply.data), "hello, world")
    client.close()
    await t
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 1 unary echo — " + string(e)) }

// 2 — unknown method -> UNIMPLEMENTED trailers-only response
try {
    var srv2: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv2.register("/echo.Echo/Say", sayHandler)
    var port2: int = portOf(srv2.addr())
    var t2: Task<void> = spawn runServer(srv2)

    var client2: GrpcClient = new GrpcClient("127.0.0.1", port2)
    var reply2: GrpcReply = client2.unary("/echo.Echo/Missing", encodeName("x"))
    test.assertEqual(reply2.status, STATUS_UNIMPLEMENTED)
    client2.close()
    await t2
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 2 unimplemented — " + string(e)) }

// 3 — empty request message round-trips
try {
    var srv3: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv3.register("/echo.Echo/Say", sayHandler)
    var port3: int = portOf(srv3.addr())
    var t3: Task<void> = spawn runServer(srv3)

    var client3: GrpcClient = new GrpcClient("127.0.0.1", port3)
    var reply3: GrpcReply = client3.unary("/echo.Echo/Say", encodeName(""))
    test.assertEqual(reply3.status, STATUS_OK)
    test.assertEqual(decodeName(reply3.data), "hello, ")
    client3.close()
    await t3
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 3 empty message — " + string(e)) }

// 4 — server-streaming: one request fans out to three responses
try {
    var srv4: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv4.registerServerStream("/echo.Echo/Count", countHandler)
    var port4: int = portOf(srv4.addr())
    var t4: Task<void> = spawn runServer(srv4)

    var client4: GrpcClient = new GrpcClient("127.0.0.1", port4)
    var call4: GrpcClientCall = client4.serverStream("/echo.Echo/Count", encodeName("x"))
    var acc4: string = ""
    var m4: Buffer? = call4.recv()
    while (m4 != null) {
        acc4 = acc4 + decodeName(m4) + ","
        m4 = call4.recv()
    }
    var rep4: GrpcReply = call4.result()
    test.assertEqual(rep4.status, STATUS_OK)
    test.assertEqual(acc4, "x0,x1,x2,")
    client4.close()
    await t4
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 4 server-stream — " + string(e)) }

// 5 — client-streaming: three requests aggregate into one reply
try {
    var srv5: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv5.registerClientStream("/echo.Echo/Collect", collectHandler)
    var port5: int = portOf(srv5.addr())
    var t5: Task<void> = spawn runServer(srv5)

    var client5: GrpcClient = new GrpcClient("127.0.0.1", port5)
    var call5: GrpcClientCall = client5.clientStream("/echo.Echo/Collect")
    call5.send(encodeName("a"))
    call5.send(encodeName("b"))
    call5.send(encodeName("c"))
    call5.closeSend()
    var got5: string = ""
    var m5: Buffer? = call5.recv()
    if (m5 != null) {
        got5 = decodeName(m5)
    }
    var rep5: GrpcReply = call5.result()
    test.assertEqual(rep5.status, STATUS_OK)
    test.assertEqual(got5, "count=3")
    client5.close()
    await t5
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 5 client-stream — " + string(e)) }

// 6 — bidirectional streaming: three requests echoed back interleaved
try {
    var srv6: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv6.registerBidiStream("/echo.Echo/Chat", chatHandler)
    var port6: int = portOf(srv6.addr())
    var t6: Task<void> = spawn runServer(srv6)

    var client6: GrpcClient = new GrpcClient("127.0.0.1", port6)
    var call6: GrpcClientCall = client6.bidiStream("/echo.Echo/Chat")
    call6.send(encodeName("1"))
    call6.send(encodeName("2"))
    call6.send(encodeName("3"))
    call6.closeSend()
    var acc6: string = ""
    var m6: Buffer? = call6.recv()
    while (m6 != null) {
        acc6 = acc6 + decodeName(m6) + ","
        m6 = call6.recv()
    }
    var rep6: GrpcReply = call6.result()
    test.assertEqual(rep6.status, STATUS_OK)
    test.assertEqual(acc6, "echo:1,echo:2,echo:3,")
    client6.close()
    await t6
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 6 bidi-stream — " + string(e)) }

// 7 — client deadline fires: slow server, short timeout -> DEADLINE_EXCEEDED
try {
    var srv7: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv7.register("/echo.Echo/Slow", slowHandler)
    var port7: int = portOf(srv7.addr())
    var t7: Task<void> = spawn runServer(srv7)

    var client7: GrpcClient = new GrpcClient("127.0.0.1", port7)
    var rep7: GrpcReply = client7.unaryWithin("/echo.Echo/Slow", encodeName("x"), 50)
    test.assertEqual(rep7.status, STATUS_DEADLINE_EXCEEDED)
    client7.close()
    await t7
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 7 deadline fires — " + string(e)) }

// 8 — under deadline: fast server, generous timeout -> OK
try {
    var srv8: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv8.register("/echo.Echo/Say", sayHandler)
    var port8: int = portOf(srv8.addr())
    var t8: Task<void> = spawn runServer(srv8)

    var client8: GrpcClient = new GrpcClient("127.0.0.1", port8)
    var rep8: GrpcReply = client8.unaryWithin("/echo.Echo/Say", encodeName("ada"), 5000)
    test.assertEqual(rep8.status, STATUS_OK)
    test.assertEqual(decodeName(rep8.data), "hello, ada")
    client8.close()
    await t8
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 8 under deadline — " + string(e)) }

// 9 — server observes the propagated grpc-timeout header
try {
    var srv9: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv9.register("/echo.Echo/Deadline", deadlineEchoHandler)
    var port9: int = portOf(srv9.addr())
    var t9: Task<void> = spawn runServer(srv9)

    var client9: GrpcClient = new GrpcClient("127.0.0.1", port9)
    var rep9: GrpcReply = client9.unaryWithin("/echo.Echo/Deadline", encodeName("x"), 5000)
    test.assertEqual(rep9.status, STATUS_OK)
    test.assertEqual(decodeName(rep9.data), "has-deadline")
    client9.close()
    await t9
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 9 server deadline header — " + string(e)) }

// 10 — server observes client cancellation via stream.cancelled()
try {
    var srv10: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv10.registerServerStream("/echo.Echo/Watch", watchHandler)
    var port10: int = portOf(srv10.addr())
    var t10: Task<void> = spawn runServer(srv10)

    var client10: GrpcClient = new GrpcClient("127.0.0.1", port10)
    var call10: GrpcClientCall = client10.serverStream("/echo.Echo/Watch", encodeName("go"))
    var first10: Buffer? = call10.recv()
    var firstName10: string = ""
    if (first10 != null) { firstName10 = decodeName(first10) }
    test.assertEqual(firstName10, "started")
    call10.cancel()
    var saw10: bool? = cancelSignal.receive()
    test.assertEqual(saw10, true)
    client10.close()
    await t10
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 10 server observes cancel — " + string(e)) }

// 11 — client cancel(): result() returns CANCELLED promptly
try {
    var srv11: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv11.registerServerStream("/echo.Echo/Watch", watchHandler)
    var port11: int = portOf(srv11.addr())
    var t11: Task<void> = spawn runServer(srv11)

    var client11: GrpcClient = new GrpcClient("127.0.0.1", port11)
    var call11: GrpcClientCall = client11.serverStream("/echo.Echo/Watch", encodeName("go"))
    var first11: Buffer? = call11.recv()
    call11.cancel()
    var rep11: GrpcReply = call11.result()
    test.assertEqual(rep11.status, STATUS_CANCELLED)
    var sig11: bool? = cancelSignal.receive()   // let the handler drain & exit
    client11.close()
    await t11
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 11 client cancel result — " + string(e)) }

// 12 — unary request metadata: server reads custom header sent by client
try {
    var srv12: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv12.register("/echo.Echo/Meta", metaUnaryHandler)
    var port12: int = portOf(srv12.addr())
    var t12: Task<void> = spawn runServer(srv12)

    var client12: GrpcClient = new GrpcClient("127.0.0.1", port12)
    var md12: Metadata = new Metadata()
    md12.set("x-user", "bob")
    var rep12: GrpcReply = client12.unaryMeta("/echo.Echo/Meta", encodeName("x"), md12)
    test.assertEqual(rep12.status, STATUS_OK)
    test.assertEqual(decodeName(rep12.data), "u=bob")
    client12.close()
    await t12
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 12 unary request metadata — " + string(e)) }

// 13 — response metadata: client reads server header + trailer
try {
    var srv13: GrpcServer = new GrpcServer("127.0.0.1", 0)
    srv13.registerServerStream("/echo.Echo/MetaStream", metaStreamHandler)
    var port13: int = portOf(srv13.addr())
    var t13: Task<void> = spawn runServer(srv13)

    var client13: GrpcClient = new GrpcClient("127.0.0.1", port13)
    var md13: Metadata = new Metadata()
    md13.set("X-User", "ada")   // mixed case key is lowercased on the wire
    var call13: GrpcClientCall = client13.serverStreamMeta("/echo.Echo/MetaStream", encodeName("x"), md13)
    var first13: Buffer? = call13.recv()
    var body13: string = ""
    if (first13 != null) { body13 = decodeName(first13) }
    var rep13: GrpcReply = call13.result()
    test.assertEqual(body13, "user=ada")
    test.assertEqual(rep13.status, STATUS_OK)
    test.assertEqual(call13.headers().get("x-server"), "v1")
    test.assertEqual(call13.trailers().get("x-trailer"), "done")
    client13.close()
    await t13
    passed = passed + 1
} catch (e) { failed = failed + 1; print("FAIL 13 response metadata — " + string(e)) }

print("═══════════════════════════════════════")
print("  gRPC h2c round-trip test results")
print("  Passed: " + string(passed))
print("  Failed: " + string(failed))
print("  Total:  " + string(passed + failed))
print("═══════════════════════════════════════")
